// Model principal para publicidades
model Advertisement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Informações básicas
  title       String
  description String?
  tagline     String? // Frase de chamada

  // Conteúdo e mídia
  content      String? // HTML/texto da publicidade
  imageUrl     String? // URL da imagem principal
  videoUrl     String? // URL do vídeo
  thumbnailUrl String? // Thumbnail do vídeo

  // Links e ações
  ctaText    String? // Texto do call-to-action
  targetUrl  String? // URL de destino
  isExternal Boolean @default(true) // Link externo?

  // Configurações de exibição
  type      AdType      @default(BANNER)
  placement AdPlacement @default(SIDEBAR_RIGHT)
  status    AdStatus    @default(DRAFT)

  // Targeting e segmentação
  targetType AdTargetType @default(GENERAL)

  // Dados do anunciante
  advertiserName    String
  advertiserEmail   String?
  advertiserPhone   String?
  advertiserWebsite String?
  advertiserLogo    String?

  // Configurações de exibição
  priority  Int  @default(0) // Prioridade (maior = mais prioridade)
  weight    Int  @default(1) // Peso para rotação
  maxViews  Int? // Limite de visualizações
  maxClicks Int? // Limite de cliques

  // Agendamento
  startDate DateTime?
  endDate   DateTime?

  // Configurações de responsividade
  showOnMobile  Boolean @default(true)
  showOnTablet  Boolean @default(true)
  showOnDesktop Boolean @default(true)

  // Configurações avançadas
  customCSS String? // CSS customizado
  customJS  String? // JavaScript customizado

  // Dados de moderação
  isApproved      Boolean   @default(false)
  approvedBy      String?   @db.ObjectId
  approvedAt      DateTime?
  rejectionReason String?

  // Controle de acesso
  createdBy    String    @db.ObjectId
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  creator  User  @relation("AdCreator", fields: [createdBy], references: [id])
  approver User? @relation("AdApprover", fields: [approvedBy], references: [id])
  editor   User? @relation("AdEditor", fields: [lastEditedBy], references: [id])

  // Targeting específico
  instrumentTargets AdInstrumentTarget[]
  composerTargets   AdComposerTarget[]
  epochTargets      AdEpochTarget[]
  userLevelTargets  AdUserLevelTarget[]
  geoTargets        AdGeoTarget[]

  // Mídia associada
  mediaFiles AdMedia[]

  // Estatísticas
  stats AdStats[]

  // Índices otimizados
  @@index([status, placement, priority])
  @@index([targetType, status])
  @@index([startDate, endDate, status])
  @@index([placement, status, priority])
  @@index([createdBy])
  @@index([isApproved, status])
  @@map("advertisements")
}

