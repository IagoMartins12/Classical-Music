// Updated Prisma schema with enhanced study mode fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums existentes + novos
enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL     // Foco técnico
  EXPRESSIVITY  // Foco na expressividade
  PRECISION     // Foco na precisão
  SIGHT_READING // Leitura à primeira vista
  MEMORIZATION  // Memorização
  PERFORMANCE   // Preparação para performance
  REVIEW        // Revisão geral
}

enum WorkType {
  INDIVIDUAL
  COMPLETE_WORK
  ARRANGEMENT
  COLLECTION
  COLLABORATION
  COMPOSITION
  COLLECTED_WORKS
  COLLECTIONS_WITH
}

enum UserType {
  MUSIC_STUDENT
  CASUAL_USER
  PROFESSIONAL
  TEACHER
}

enum AccountProvider {
  GOOGLE
  EMAIL
  FACEBOOK
}

// NOVO: Tipos de anotações no PDF
enum AnnotationType {
  TEXT_NOTE    // Nota de texto
  HIGHLIGHT    // Destaque
  DRAWING      // Desenho livre
  BOOKMARK     // Marcador
  FINGERING    // Dedilhado
  BOWINGS      // Arcadas (cordas)
  DYNAMICS     // Dinâmicas
  TEMPO_MARK   // Marcação de tempo
}

enum IMSLPScoreType {
  SCORES
  PARTS
  ARRANGEMENTS
  LIBRETTOS
  OTHERS
  SOURCES
}
// Models existentes... (mantenho os existentes)

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  gender         String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role Int @default(0)

  userType            UserType?
  onboardingCompleted Boolean   @default(false)

  city    String?
  state   String?
  country String?

  favoriteComposerId String? @db.ObjectId
  favoriteEpochId    String? @db.ObjectId

  experienceLevel     DifficultyLevel @default(BEGINNER)
  practiceTimePerWeek Int?

  profilePublic Boolean @default(true)
  showLocation  Boolean @default(false)

  practiceReminders Boolean @default(true)
  progressTracking  Boolean @default(true)
  publicProgress    Boolean @default(false)

  totalStudyTime    Int     @default(0)
  currentStreak     Int     @default(0)
  longestStreak     Int     @default(0)

  // NOVOS: Configurações do modo estudo
  studyModeSettings Json? // { defaultMetronome: { bpm: 120, sound: 'click' }, pdfSettings: { zoom: 1.2, theme: 'light' } }

  // Relations
  accounts Account[]
  sessions Session[]
  selectedScores UserSelectedScore[]

  favoriteComposer Composer? @relation("FavoriteComposer", fields: [favoriteComposerId], references: [id])
  favoriteEpoch    Epoch?    @relation("FavoriteEpoch", fields: [favoriteEpochId], references: [id])

  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]
  studySessions     StudySession[]
  learningGoals     LearningGoal[]
  
  // NOVOS: Anotações no PDF e bookmarks
  pdfAnnotations    PdfAnnotation[]
  scoreBookmarks    ScoreBookmark[]

  @@index([userType])
  @@index([onboardingCompleted])
}

// Todos os outros models existentes permanecem... 
// (Composer, Epoch, Role, Instrument, Work, etc.)

// NOVO: Model para anotações específicas no PDF
model PdfAnnotation {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  userId   String         @db.ObjectId
  workId   String         @db.ObjectId
  scoreId  String         // ID da partitura IMSLP
  
  type     AnnotationType
  content  String?        // Texto da anotação
  
  // Posição no PDF
  page     Int            // Página do PDF
  x        Float          // Coordenada X (percentual)
  y        Float          // Coordenada Y (percentual)
  width    Float?         // Largura (para highlights/desenhos)
  height   Float?         // Altura (para highlights/desenhos)
  
  // Dados específicos por tipo
  color    String?        // Cor da anotação (#hex)
  fontSize Int?          // Tamanho da fonte (para texto)
  strokeWidth Float?     // Espessura do traço (para desenhos)
  drawing  Json?         // Dados do desenho livre (SVG path)
  
  // Metadados
  measure  Int?          // Compasso relacionado (se aplicável)
  beat     Float?        // Tempo do compasso
  voice    Int?          // Voz musical (1, 2, 3...)
  
  isPublic Boolean       @default(false)
  tags     String[]      @default([])
  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@index([userId, workId, scoreId])
  @@index([workId, scoreId, page])
  @@index([type])
}

// NOVO: Model para bookmarks/marcadores na partitura
model ScoreBookmark {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  workId      String   @db.ObjectId
  scoreId     String   // ID da partitura IMSLP
  
  title       String   // Ex: "Desenvolvimento", "Tema principal"
  description String?
  color       String   @default("#3B82F6") // Cor do marcador
  
  // Posição
  page        Int      // Página
  measure     Int?     // Compasso (se identificado)
  system      Int?     // Sistema na página
  
  // Coordenadas aproximadas para visualização
  x           Float?
  y           Float?
  
  // Ordem personalizada pelo usuário
  sortOrder   Int      @default(0)
  
  isPublic    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@index([userId, workId, scoreId])
  @@index([workId, scoreId])
  @@index([sortOrder])
}

// MELHORADO: StudySession com mais campos
model StudySession {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  workId        String        @db.ObjectId
  scoreId       String?       // ID da partitura específica estudada
  
  date          DateTime      @default(now())
  durationMin   Int           // duração em minutos
  
  // Detalhes da sessão
  metronomeUsed Boolean       @default(false)
  tempoMarking  String?       // Andamento praticado
  focus         PracticeFocus
  notes         String?
  rating        Int?          // 1-5 como foi a sessão
  
  // Progresso específico
  sectionsWorked String[]     @default([]) // Seções específicas trabalhadas
  challenges     String?      // Desafios encontrados
  breakthroughs  String?      // Progressos ou descobertas
  
  // Ambiente e condições
  instrument     String?      // Instrumento usado (se tiver múltiplos)
  location       String?      // Onde praticou
  mood           Int?         // 1-5 humor antes da prática
  energy         Int?         // 1-5 energia depois da prática

  // Configurações detalhadas
  metronomeSettings Json?     // { bpm: number, timeSignature: string, sound: string, volume: number }
  selectedScore     Json?     // Dados da partitura selecionada
  studyNotes        String?   // Anotações durante o estudo
  practiceGoals     String[]  @default([]) // Objetivos para esta sessão
  technicalFocus    String[]  @default([]) // Focos técnicos trabalhados
  expressiveFocus   String[]  @default([]) // Focos expressivos trabalhados
  precisionFocus    String[]  @default([]) // Focos de precisão trabalhados
  
  // Avaliação pós-prática
  postPracticeRating Int?     // 1-5 satisfação com a sessão
  postPracticeNotes  String?  // Notas de reflexão
  nextSessionGoals   String[] @default([]) // Objetivos para próxima sessão
  
  // Métricas detalhadas
  pauseCount        Int       @default(0) // Quantas vezes pausou
  restartCount      Int       @default(0) // Quantas vezes recomeçou
  sectionsRepeated  Json?     // Seções que foram repetidas e quantas vezes
  
  // NOVOS: Tracking de interações com a partitura
  pagesViewed       Int[]     @default([]) // Páginas que foram visualizadas
  annotationsCreated Int      @default(0)  // Quantas anotações foram criadas
  bookmarksCreated   Int      @default(0)  // Quantos bookmarks foram criados
  pdfZoomChanges     Int      @default(0)  // Quantas vezes mudou o zoom
  
  // Configurações da sessão
  pdfSettings       Json?     // { zoom: number, theme: 'light'|'dark', layout: 'single'|'spread' }
  windowLayout      Json?     // Layout da tela (posições dos painéis)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([workId, date])
  @@index([userId, workId])
  @@index([scoreId])
}

// Restante dos models existentes permanecem iguais...
// (Account, Session, VerificationToken, Composer, Epoch, Role, Instrument, Work, etc.)

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Composer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  fullName      String
  birthDate     String?
  deathDate     String?
  portraitUrl   String?
  epochId       String   @db.ObjectId
  epochName     String?
  bio           String?
  createdAt     DateTime @default(now())
  permLinkImslp String?
  imslpId       String?
  wikipediaLink String?

  primaryRoleId String @db.ObjectId
  primaryRole   Role   @relation("PrimaryRole", fields: [primaryRoleId], references: [id])

  epoch       Epoch              @relation(fields: [epochId], references: [id])
  works       Work[]
  favoritedBy FavoriteComposer[]

  favoriteByUsers User[] @relation("FavoriteComposer")

  roles String?

  @@index([name])
  @@index([epochId])
  @@index([fullName])
  @@index([primaryRoleId])
  @@index([imslpId])
  @@index([name, epochId])
  @@index([epochId, primaryRoleId])
  @@index([name, fullName])
}

model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers       Composer[]
  works           Work[]
  favoriteByUsers User[]     @relation("FavoriteEpoch")

  @@index([name])
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  primaryComposers Composer[] @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String           @unique
  category   String?
  difficulty String?
  createdAt  DateTime         @default(now())
  users      UserInstrument[]
  works      Work[]

  @@index([category])
}

model WorkGenre {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  composerId   String @db.ObjectId
  instrumentId String @db.ObjectId
  epochId      String @db.ObjectId

  videoUrl         String?
  imslpPermlink    String
  imslpId          String
  opOrCatalog      String?
  compositionYear  String?
  firstPublishDate String?
  tone             String?
  mediaDuration    String?
  workStyle        String?
  moviment         String?
  categoryNames    String[] @default([])
  workGenresArr    String[] @default([])

  dedicateTo             String?
  dedicationComposerLink String?
  instrumentation        String?
  workType               WorkType @default(INDIVIDUAL)

  isPartOfCollection Boolean @default(false)
  parentWorkId       String? @db.ObjectId
  movementNumber     Int?

  createdAt DateTime @default(now())

  composer   Composer   @relation(fields: [composerId], references: [id])
  epoch      Epoch      @relation(fields: [epochId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  parentWork Work?  @relation("WorkHierarchy", fields: [parentWorkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childWorks Work[] @relation("WorkHierarchy")

  annotations    Annotation[]
  favoriteBy     FavoriteWork[]
  wantToLearners WantToLearn[]
  learners       Learned[]
  studySessions  StudySession[]
    selectedScores UserSelectedScore[]

  // NOVOS: Anotações PDF e bookmarks
  pdfAnnotations PdfAnnotation[]
  scoreBookmarks ScoreBookmark[]

  @@index([title])
  @@index([composerId])
  @@index([imslpId])
  @@index([title, composerId])
  @@index([workType])
  @@index([parentWorkId])
  @@index([isPartOfCollection])
  @@index([composerId, instrumentId])
  @@index([composerId, epochId])
  @@index([instrumentId, epochId])
  @@index([composerId, instrumentId, epochId])
  @@index([opOrCatalog, composerId])
  @@index([categoryNames])
  @@index([workGenresArr])
}

model UserInstrument {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  instrumentId String @db.ObjectId

  level      DifficultyLevel @default(BEGINNER)
  isPrimary  Boolean         @default(false)
  isLearning Boolean         @default(true)
  startedAt  DateTime        @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

model Annotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  content   String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model WantToLearn {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  workId   String   @db.ObjectId
  priority Int      @default(0)
  addedAt  DateTime @default(now())

  notes            String?        
  targetDate       DateTime?      
  estimatedStudyTime Int?         
  difficulty       DifficultyLevel? 
  reminder         Boolean        @default(false) 
  reminderFrequency String?       
  
  motivation       String?        
  context          String?        
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, priority])
  @@index([targetDate])
}

model Learned {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  learnedAt DateTime @default(now())
  mastery   Int      @default(0)

  studyStartDate    DateTime?     
  studyDuration     Int?          
  notes             String?       
  wouldRecommend    Boolean       @default(true) 
  publicPerformance Boolean       @default(false) 
  lastPracticed     DateTime?     
  
  difficulty        DifficultyLevel? 
  enjoyment         Int?          
  technicalChallenges String?     
  musicalInsights   String?       
  
  performanceCount  Int           @default(0) 
  bestPerformance   String?       
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, mastery])
  @@index([learnedAt])
  @@index([lastPracticed])
}

model UserSelectedScore {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  workId    String
  
  // Dados da partitura (copiados do IMSLP)
  imslpScoreId   String   // ID original do IMSLP
  title          String
  downloadUrl    String
  fileSize       String?
  pageCount      String?
  fileFormat     String   @default("PDF")
  
  // Metadados adicionais
  editor         String?
  publisher      String?
  copyright      String?
  thumbnailUrl   String?
  uploadDate     String?
  uploader       String?
  notes          String?
  
  // Classificação IMSLP
  type           IMSLPScoreType  @default(SCORES)
  groupIndex     Int?
  groupTitle     String?
  
  // Rating e downloads do IMSLP
  rating         Float?
  ratingsCount   Int?
  downloadCount  Int?
  
  // Cache e timestamps
  lastVerified   DateTime @default(now())
  isActive       Boolean  @default(true)
  
  // Relacionamentos
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work           Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  // Índices para performance
  @@unique([userId, workId, imslpScoreId])
  @@index([userId, workId])
  @@index([workId])
  @@map("user_selected_scores")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningGoal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String   
  description String?
  targetDate  DateTime?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  
  workIds     String[] @db.ObjectId @default([])
  
  progressNotes String?
  milestones    String[] @default([]) 
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, targetDate])
  @@index([isCompleted])
}

model FavoriteWork {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteComposer {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  composerId String @db.ObjectId

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  composer Composer @relation(fields: [composerId], references: [id], onDelete: Cascade)

  @@unique([userId, composerId])
}