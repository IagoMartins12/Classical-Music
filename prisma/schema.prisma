  // Substituir imageUrl, thumbnailUrl, videoUrl por:
  
  // URLs principais (para compatibilidade)
  imageUrl     String? // URL da versão desktop (principal)
  thumbnailUrl String? // URL do thumbnail
  videoUrl     String? // URL da versão desktop do vídeo
  
  // 🆕 Versões responsivas (JSON fields)
  imageVersions Json? // { desktop: string, tablet: string, mobile: string, original: string, thumbnail: string }
  videoVersions Json? // { desktop: string, tablet: string, mobile: string, original: string }
  
  // 🆕 Metadados de mídia
