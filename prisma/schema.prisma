// TABELA DE PROFESSORES COMPLETA
model Teacher {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  // Informações básicas
  bio          String?
  specialties  String[] @default([]) // ["Piano", "Violão", "Teoria"]
  instruments  String[] @default([]) // Instrumentos que ensina
  experience   String? // "10 anos", "Desde 2015"
  education    String? // Formação acadêmica
  achievements String? // Conquistas, prêmios, etc.

  // Perfil público para "Conheça nossos professores"
  isPublicProfile  Boolean  @default(false)
  profileImage     String?
  website          String?
  socialMedia      Json? // {"instagram": "@professor", "youtube": "channel"}
  publicBio        String? // Bio específica para o perfil público
  highlightedWorks String[] @default([]) // Obras que o professor destaca

  // Configurações de ensino
  defaultLessonDuration Int    @default(60) // Duração padrão em minutos
  maxStudentsPerWeek    Int    @default(50) // Limite de aulas por semana
  timezone              String @default("America/Sao_Paulo")

  // Metodologia e estilo de ensino
  teachingMethod String? // Descrição da metodologia
  ageGroups      String[] @default([]) // ["Crianças", "Adultos", "Terceira idade"]
  skillLevels    String[] @default([]) // ["Iniciante", "Intermediário", "Avançado"]

  // Status e aprovação
  status     TeacherStatus @default(PENDING)
  isVerified Boolean       @default(false) // Aprovação manual
  verifiedAt DateTime?
  verifiedBy String?       @db.ObjectId // Admin que aprovou

  // Configurações de relatórios
  allowProgressReports Boolean @default(true) // Se pode ver relatórios dos alunos
  reportPreferences    Json? // Preferências de relatórios

  // Métricas e estatísticas
  totalStudents  Int    @default(0)
  totalLessons   Int    @default(0)
  averageRating  Float? @default(0)
  totalReviews   Int    @default(0)
  completionRate Float? @default(0) // Taxa de conclusão das aulas

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students TeacherStudent[] @relation("TeacherStudents")
  lessons  Lesson[]         @relation("TeacherLessons")
  reviews  TeacherReview[]  @relation("TeacherReviews")

  // Índices otimizados
  @@index([status, isVerified])
  @@index([isPublicProfile])
  @@index([instruments])
  @@index([specialties])
  @@index([ageGroups])
  @@index([averageRating])
  @@map("teachers")
}

// TABELA DE ALUNOS COMPLETA
model Student {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  // Informações básicas do aluno
  level             DifficultyLevel @default(BEGINNER)
  mainInstrument    String?
  musicalGoals      String? // Objetivos musicais
  preferredGenres   String[]        @default([])
  musicalBackground String? // Experiência anterior

  // Configurações de privacidade e relatórios
  allowPublicProgress Boolean @default(false) // Se professor pode ver progresso público
  allowProgressShare  Boolean @default(true) // Se permite compartilhar progresso
  allowWhatsappMensage Boolean @default(false)
  profileVisibility   String  @default("teacher_only") // "public", "teacher_only", "private"

  // Informações de estudo
  practiceTime     Int? // Tempo de prática semanal (minutos)
  practiceSchedule Json? // Horários preferidos para estudo
  learningPace     String? // "slow", "medium", "fast"
  specialNeeds     String? // Necessidades especiais de aprendizado

  // Status e datas importantes
  status         StudentStatus @default(ACTIVE)
  enrollmentDate DateTime      @default(now())
  lastLessonAt   DateTime?
  lastActiveAt   DateTime?     @default(now())

  // Configurações de comunicação
  preferredContact    String @default("whatsapp") // "whatsapp", "email", "both"
  reminderPreferences Json? // Preferências de lembretes

  // Métricas de progresso
  totalLessonsAttended Int    @default(0)
  totalAssignments     Int    @default(0)
  completedAssignments Int    @default(0)
  currentStreak        Int    @default(0) // Sequência de aulas sem faltas
  longestStreak        Int    @default(0)
  progressScore        Float? @default(0) // Score geral de progresso

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachers    TeacherStudent[] @relation("StudentTeachers")
  lessons     Lesson[]         @relation("StudentLessons")
  reviews     TeacherReview[]  @relation("StudentReviews")
  assignments Assignment[]     @relation("StudentAssignments")

  // Índices otimizados
  @@index([status, lastActiveAt])
  @@index([level, mainInstrument])
  @@index([allowPublicProgress])
  @@index([enrollmentDate])
  @@map("students")
}

// RELACIONAMENTO PROFESSOR-ALUNO OTIMIZADO
model TeacherStudent {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String @db.ObjectId
  studentId String @db.ObjectId

  // Configurações da relação
  maxLessonsPerWeek Int      @default(1) // Limite de aulas por semana
  lessonDuration    Int      @default(60) // Duração padrão das aulas (min)
  preferredDays     String[] @default([]) // ["monday", "wednesday", "friday"]
  preferredTimes    String[] @default([]) // ["09:00", "14:00"]

  // Status da relação
  isActive    Boolean   @default(true)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  pausedAt    DateTime? // Se foi pausada temporariamente
  pauseReason String?

  // Planejamento pedagógico
  learningPlan String? // Plano de estudos personalizado
  currentFocus String[] @default([]) // Foco atual dos estudos
  nextGoals    String? // Próximos objetivos
  teacherNotes String? // Notas privadas do professor
  studentNotes String? // Notas que o aluno pode ver

  // Configurações específicas
  homeworkFrequency String @default("weekly") // "daily", "weekly", "biweekly"
  reportFrequency   String @default("monthly") // Frequência de relatórios

  // Métricas da relação
  totalLessons      Int    @default(0)
  completedLessons  Int    @default(0)
  cancelledLessons  Int    @default(0)
  noShowLessons     Int    @default(0)
  relationshipScore Float? @default(0) // Score da qualidade da relação

  inviteStatus     StudentInviteStatus @default(PENDING)
  inviteAcceptedAt DateTime?
  inviteDeclinedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  teacher Teacher @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation("StudentTeachers", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([teacherId, isActive])
  @@index([studentId, isActive])
  @@index([startDate, endDate])
  @@map("teacher_students")
}

// TABELA DE AULAS COMPLETA
model Lesson {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String @db.ObjectId
  studentId String @db.ObjectId

  // Informações básicas
  title       String
  description String?
  objectives  String[] @default([]) // Objetivos da aula

  // Agendamento e duração
  scheduledAt     DateTime
  duration        Int       @default(60) // em minutos
  actualStartTime DateTime? // Hora real de início
  actualEndTime   DateTime? // Hora real de fim

  // Status e tipo
  status   LessonStatus @default(SCHEDULED)
  type     LessonType   @default(INDIVIDUAL)
  location String? // "Online", "Estúdio A", "Casa do aluno"

  // Sistema de recorrência
  isRecurring    Boolean        @default(false)
  recurrenceType RecurrenceType @default(NONE)
  parentLessonId String?        @db.ObjectId // Aula pai da série
  recurrenceEnd  DateTime? // Data fim da recorrência

  // Conteúdo e materiais da aula
  workScoreIds String[] @default([]) @db.ObjectId // Partituras específicas
  worksIds     String[] @default([]) @db.ObjectId // Partituras específicas  
  topics       String[] @default([]) // Tópicos abordados
  techniques   String[] @default([]) // Técnicas trabalhadas
  repertoire   String[] @default([]) // Repertório estudado

  // Homework e tarefas
  homework       String? // Lição de casa geral
  practiceGoals  String[] @default([]) // Metas específicas de prática
  nextLessonPrep String? // Preparação para próxima aula

  // Anotações e feedback
  teacherNotes    String? // Notas privadas do professor
  publicNotes     String? // Notas visíveis para o aluno
  studentFeedback String? // Feedback do aluno sobre a aula
  lessonSummary   String? // Resumo da aula

  // Avaliação e progresso
  studentProgress Json? // Progresso específico da aula
  skillsWorked    String[] @default([]) // Habilidades trabalhadas
  improvements    String[] @default([]) // Melhorias observadas
  challenges      String[] @default([]) // Desafios encontrados

  // Presença e participação
  studentPresent Boolean? // null = não marcado
  punctuality    String? // "on_time", "late", "early"
  engagement     Int? // 1-5 nível de engajamento
  preparation    Int? // 1-5 quão preparado estava

  // Informações de cancelamento/reagendamento
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String? // "teacher", "student", "system"
  rescheduledFrom  DateTime? // Data original se foi reagendada
  rescheduleReason String?

  // Mídia e recursos
  audioRecordings String[] @default([]) // URLs de gravações
  videoRecordings String[] @default([]) // URLs de vídeos
  documents       String[] @default([]) // Documentos anexos
  images          String[] @default([]) // Fotos da aula

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  teacher      Teacher      @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  student      Student      @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  parentLesson Lesson?      @relation("LessonSeries", fields: [parentLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childLessons Lesson[]     @relation("LessonSeries")
  assignments  Assignment[] @relation("LessonAssignments")

  // Índices otimizados
  @@index([teacherId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@index([scheduledAt, status])
  @@index([isRecurring, recurrenceType])
  @@index([status, type])
  @@index([teacherId, studentId, scheduledAt]) // Para detecção de conflitos
  @@map("lessons")
}

// SISTEMA DE TAREFAS/ASSIGNMENTS MELHORADO
model Assignment {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  lessonId  String @db.ObjectId
  studentId String @db.ObjectId

  // Informações da tarefa
  title       String
  description String
  type        String @default("practice") // "practice", "theory", "listening", "composition"
  priority    String @default("medium") // "low", "medium", "high"

  // Recursos e materiais
  workScoreIds String[] @default([]) @db.ObjectId // Partituras para estudar
  worksIds     String[] @default([]) @db.ObjectId // Partituras para estudar

  exercises  String[] @default([]) // Exercícios específicos

  // Metas específicas
  practiceGoals  String[] @default([]) // Metas de prática
  tempoTargets   Json? // Metas de tempo/andamento
  technicalGoals String[] @default([]) // Objetivos técnicos
  musicalGoals   String[] @default([]) // Objetivos musicais

  // Status e prazos
  status        AssignmentStatus @default(PENDING)
  dueDate       DateTime?
  estimatedTime Int? // Tempo estimado em minutos
  actualTime    Int? // Tempo real gasto pelo aluno

  // Progresso e completion
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  progress    Float?    @default(0) // 0-100%

  // Feedback e avaliação
  teacherFeedback String? // Feedback do professor
  teacherRating   Int? // 1-5 avaliação do professor
  studentNotes    String? // Notas do aluno
  studentRating   Int? // 1-5 dificuldade percebida pelo aluno

  // Submissões do aluno
  submissions    Json? // Gravações, fotos, etc. enviadas pelo aluno
  submissionDate DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  lesson  Lesson  @relation("LessonAssignments", fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  // Índices otimizados
  @@index([studentId, status])
  @@index([studentId, dueDate])
  @@index([lessonId, status])
  @@index([status, dueDate])
  @@index([type, priority])
  @@map("assignments")
}

// SISTEMA DE AVALIAÇÕES MELHORADO
model TeacherReview {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String @db.ObjectId
  studentId String @db.ObjectId

  // Avaliação básica
  rating   Int // 1-5 estrelas
  comment  String?
  isPublic Boolean @default(true)

  // Avaliações específicas
  teachingQuality Int? // 1-5
  communication   Int? // 1-5  
  punctuality     Int? // 1-5
  preparation     Int? // 1-5
  patience        Int? // 1-5
  motivation      Int? // 1-5

  // Informações contextuais
  relationshipDuration String? // "1 mês", "6 meses", "2 anos"
  lessonsCount         Int? // Quantas aulas teve
  wouldRecommend       Boolean @default(true)

  // Moderação
  isModerated    Boolean   @default(false)
  moderatedBy    String?   @db.ObjectId
  moderatedAt    DateTime?
  moderationNote String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  teacher Teacher @relation("TeacherReviews", fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId]) // Um aluno só pode avaliar um professor uma vez
  @@index([teacherId, isPublic])
  @@index([rating, createdAt])
  @@index([isModerated])
  @@map("teacher_reviews")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  status    NotificationStatus   @default(UNREAD)
  
  // Conteúdo da notificação
  title       String
  message     String
  actionText  String? // Texto do botão (ex: "Ver Aula", "Marcar como Feito")
  actionUrl   String? // URL para onde levar o usuário
  
  // Dados relacionados (para construir links dinâmicos)
  relatedEntityType String? // "lesson", "assignment", "student", etc.
  relatedEntityId   String? @db.ObjectId
  
  // 🆕 CAMPO PARA PREVENÇÃO DE DUPLICATAS
  uniqueHash String? // Hash único baseado em tipo + entidade + metadata específicos
  
  // Metadados adicionais
  metadata Json? // Dados extras específicos por tipo
  
  // Configurações de exibição
  showInToast   Boolean @default(true)  // Mostrar como toast
  showInBrowser Boolean @default(false) // Mostrar como notificação browser
  showInPage    Boolean @default(true)  // Mostrar na página de notificações
  
  // Controle de repetição (REMOVIDO cooldown)
  lastShownAt DateTime? // Última vez que foi mostrada como toast
  
  // Agendamento
  scheduledFor DateTime? // Quando deve ser mostrada (para agendamentos futuros)
  expiresAt    DateTime? // Data de expiração (auto-cleanup)
  
  // Controle de entrega
  toastShown    Boolean @default(false) // Toast já foi mostrado
  browserShown  Boolean @default(false) // Notificação browser já foi mostrada
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  readAt    DateTime? // Quando foi marcada como lida
  
  // Relações
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  // 🆕 ÍNDICES OTIMIZADOS PARA PREVENÇÃO DE DUPLICATAS
  @@index([userId, status, createdAt])
  @@index([userId, type, status])
  @@index([scheduledFor, status])
  @@index([expiresAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([priority, status, createdAt])
  @@index([showInToast, toastShown])
  @@index([showInBrowser, browserShown])
  
  // 🆕 ÍNDICES PARA PREVENÇÃO DE DUPLICATAS
  @@index([userId, type, relatedEntityId, status]) // Principal para verificar duplicatas
  @@index([uniqueHash]) // Para verificação rápida por hash
  @@index([userId, type, relatedEntityId, expiresAt]) // Para verificação com expiração
  
  // 🆕 CONSTRAINT OPCIONAL PARA HASH ÚNICO (se quiser garantir a nível de DB)
  // @@unique([uniqueHash], name: "unique_notification_hash")
  
  @@map("notifications")
}

model SchoolActivity {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId // Quem fez a ação
  userType String // "teacher" ou "student"
  
  // Informações da ação
  action      SchoolActivityAction
  entityType  String  // "lesson", "assignment", "profile", "student", etc.
  entityId    String? @db.ObjectId // ID da entidade relacionada
  entityName  String? // Nome/título da entidade para facilitar exibição
  
  // Descrição e detalhes
  title       String  // Título amigável da ação
  description String? // Descrição detalhada
  
  // Dados das mudanças (para updates)
  changes  Json? // Mudanças específicas (oldValue, newValue)
  metadata Json? // Dados extras (IDs relacionados, contexto, etc.)
  
  // Timestamps
  createdAt DateTime @default(now())
  
  // Relações
  user User @relation("UserSchoolActivities", fields: [userId], references: [id], onDelete: Cascade)
  
  // Índices otimizados
  @@index([userId, createdAt]) // Principal para buscar atividades por usuário
  @@index([userType, action, createdAt]) // Para filtros por tipo
  @@index([entityType, entityId]) // Para buscar por entidade
  @@index([createdAt]) // Para limpeza/manutenção
  @@index([userId, action, createdAt]) // Para filtros específicos
  
  @@map("school_activities")
}

// Modelo para conquistas do usuário
model UserAchievement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Identificação
  userId  String @db.ObjectId
  badgeId String // ID único do badge (ex: "first-goal", "collector-bronze")
  
  // Informações da conquista
  name        String
  description String
  category    AchievementCategory
  rarity      AchievementRarity
  
  // Progresso e completude
  progress    Int? // Progresso atual (se aplicável)
  maxProgress Int? // Progresso máximo (se aplicável)
  
  // XP e recompensas
  xpReward Int @default(0)
  
  // Controle de notificação
  isNew                  Boolean   @default(true) // Se é nova (não vista pelo usuário)
  notificationShown      Boolean   @default(false) // Se toast foi mostrado
  notificationShownAt    DateTime? // Quando toast foi mostrado
  lastViewedAt          DateTime? // Última vez que foi vista
  
  // Timestamps
  unlockedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  
  // Relações
  user User @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  
  // Constraints
  @@unique([userId, badgeId])
  @@index([userId, category])
  @@index([userId, rarity]) 
  @@index([userId, isNew])
  @@index([category, rarity])
  @@index([unlockedAt])
  
  @@map("user_achievements")
}

// Modelo para tracking de progresso de conquistas
model AchievementProgress {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  userId  String @db.ObjectId
  badgeId String // ID do badge sendo rastreado
  
  // Valores de progresso
  currentValue       Int       @default(0) // Valor atual
  lastCheckedAt      DateTime  @default(now())
  lastProgressUpdate DateTime? // Última vez que houve progresso
  
  // Metadados para otimização
  metadata Json? // Dados específicos para o cálculo
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  user User @relation("AchievementProgress", fields: [userId], references: [id], onDelete: Cascade)
  
  // Constraints
  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([lastProgressUpdate])
  
  @@map("achievement_progress")
}