// This is your Prisma schema file for the classical music encyclopedia project
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums
enum DifficultyLevel {
  null
  UNKNOWN
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL
  EXPRESSIVITY
  PRECISION
}

// Models
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  gender         String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  Account           Account[]
  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]
  studySessions     StudySession[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Composer {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  fullName        String
  birthDate       String?
  deathDate       String?
  portraitUrl     String?
  epochId         String         @db.ObjectId
  epochName       String?
  bio             String?
  createdAt       DateTime       @default(now())
  permLinkImslp   String?
  imslpId         String?        // IMPORTANTE: usado pelo scraper para matching
  wikipediaLink   String?

  // Primary role
  primaryRoleId   String         @db.ObjectId
  primaryRole     Role           @relation("PrimaryRole", fields: [primaryRoleId], references: [id])

  // Relationships
  epoch           Epoch          @relation(fields: [epochId], references: [id])
  works           Work[]
  favoritedBy     FavoriteComposer[]

  // Additional roles (many-to-many)
  roles           String?

  @@index([name])
  @@index([epochId])
  @@index([name, epochId])
  @@index([fullName])
  @@index([primaryRoleId])
  @@index([imslpId]) // ADICIONADO: Para busca eficiente pelo scraper
}

model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers Composer[]
  works Work[]

  @@index([name])
}

model Genre {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now()) // ADICIONADO: Para rastreamento de criação pelo scraper
  works     Work[]
}

model Role {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String

  // Composers with this as their primary role
  primaryComposers Composer[]     @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String           @unique
  createdAt DateTime         @default(now()) // ADICIONADO: Para rastreamento de criação pelo scraper
  users     UserInstrument[]
  works     Work[]
}

model Categorie {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  works Work[]
  createdAt DateTime         @default(now()) // ADICIONADO: Para rastreamento de criação pelo scraper
}

model Work {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  composerId        String          @db.ObjectId
  genreId           String          @db.ObjectId
  instrumentId      String          @db.ObjectId
  epochId           String          @db.ObjectId
  categoriesId      String          @db.ObjectId
  
  // URLs e links
  videoUrl          String?
  imslpPermlink     String          // CORRIGIDO: era permlinkImslp, scraper usa imslpPermlink
  
  // IMPORTANTE: Campo crítico para evitar duplicatas
  imslpId           String          @unique // ADICIONADO: essencial para o scraper
  
  // Metadados da obra
  opOrCatalog       String?
  compositionYear   String?
  firstPublishDate  String?
  tone              String?
  mediaDuration     String?
  workStyle         String?
  moviment          String?         // Mantido como está no scraper
  dedicateTo        String?         // ADICIONADO: usado pelo scraper
  dedicationComposerLink String?
  instrumentation   String?         // ADICIONADO: usado pelo scraper
  genres            String?         // ADICIONADO: lista de gêneros como string
  difficultyLevel   Int?
  workType          String?
  isPartOfCollection Boolean @default(false)
  parentWorkId    String?

  movementNumber Int?
  // Sistema
  difficulty        String?        
  createdAt         DateTime        @default(now())
  
  // Relations
  composer          Composer        @relation(fields: [composerId], references: [id])
  genre             Genre           @relation(fields: [genreId], references: [id])
  epoch             Epoch           @relation(fields: [epochId], references: [id])
  instrument        Instrument      @relation(fields: [instrumentId], references: [id])
  categories        Categorie       @relation(fields: [categoriesId], references: [id])
  
  annotations       Annotation[]
  favoriteBy        FavoriteWork[]
  wantToLearners    WantToLearn[]
  learners          Learned[]
  studySessions     StudySession[]
  
  // ADICIONADO: Índices para performance do scraper
  @@index([title])
  @@index([composerId])
  @@index([title, composerId]) // Para verificação de duplicatas
}

// Join tables
model UserInstrument {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  instrumentId String @db.ObjectId

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

// User-generated content
model Annotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model StudySession {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  workId        String        @db.ObjectId
  date          DateTime      @default(now())
  durationMin   Int // duração em minutos
  metronomeUsed Boolean       @default(false)
  focus         PracticeFocus
  notes         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

// Wishlists and favorites
model WantToLearn {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model Learned {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  learnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteWork {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteComposer {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  composerId String @db.ObjectId

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  composer Composer @relation(fields: [composerId], references: [id], onDelete: Cascade)

  @@unique([userId, composerId])
}