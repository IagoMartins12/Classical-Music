  // Configurações de remetente
  senderName      String  @default("Opus Atlas")
  senderEmail     String  @default("noreply@opusatlas.com")
  replyToEmail    String?
  
  // Configurações
  isActive        Boolean @default(true)
  isDefault       Boolean @default(false) // Template padrão para o tipo
  
  // Metadados
  description     String?
  previewText     String? // Texto de preview no email client
  tags            String[] @default([])
  
  // Estatísticas (cache)
  timesUsed       Int     @default(0)
  avgOpenRate     Float?  @default(0)
  avgClickRate    Float?  @default(0)
  
  // 🆕 NOVOS CAMPOS PARA MELHOR GESTÃO
  category        String? // Categoria personalizada (ex: "Promocional", "Transacional")
  priority        Int     @default(0) // Prioridade de exibição
  
  // Configurações avançadas
  trackingEnabled Boolean @default(true) // Se deve rastrear aberturas/cliques
  autoTextVersion Boolean @default(true) // Se deve gerar versão texto automaticamente
  
  // Dados de qualidade
  qualityScore    Float?  // Score de qualidade calculado (0-100)
  lastQualityCheck DateTime? // Última verificação de qualidade
  
  // Configurações de uso
  usageRestrictions Json? // Restrições de uso (ex: apenas para admins, frequência máxima)
  expiresAt        DateTime? // Data de expiração do template (opcional)
  
  // Controle de acesso
  createdBy       String  @db.ObjectId
  lastEditedBy    String? @db.ObjectId
  lastEditedAt    DateTime?
  
  // Aprovação (opcional)
  approvalStatus  String  @default("approved") // "pending", "approved", "rejected"
  approvedBy      String? @db.ObjectId
  approvedAt      DateTime?
  approvalNotes   String?
  
  // Relações
  creator         User                 @relation("NewsletterTemplateCreator", fields: [createdBy], references: [id])
  editor          User?                @relation("NewsletterTemplateEditor", fields: [lastEditedBy], references: [id])
  approver        User?                @relation("NewsletterTemplateApprover", fields: [approvedBy], references: [id])
  campaigns       NewsletterCampaign[]
  
  // Novos relacionamentos
  derivedFromId   String?              @db.ObjectId
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices otimizados
  @@index([type, isActive])
  @@index([isDefault, type])
  @@index([createdBy])
  @@index([tags])
  @@index([category, priority]) // 🆕 Para categorização
  @@index([qualityScore]) // 🆕 Para rankings de qualidade
  @@index([approvalStatus]) // 🆕 Para fluxo de aprovação
  @@index([timesUsed, avgOpenRate]) // 🆕 Para análise de performance
  @@index([expiresAt]) // 🆕 Para limpeza automática
  @@map("newsletter_templates")
}


// Campanhas de email
model NewsletterCampaign {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  // Configurações básicas
  subject      String
  templateId   String?        @db.ObjectId // 🆕 Tornar opcional
  templateType String?        // 🆕 Tipo de template usado (para built-in)
  status       CampaignStatus @default(DRAFT)
  
  // 🆕 NOVOS CAMPOS PARA MELHOR INTEGRAÇÃO COM TEMPLATES
  useCustomTemplate Boolean @default(false) // Se usa template personalizado
  templateSnapshot  Json?   // Snapshot do template no momento do envio
  
  // Agendamento
  scheduledAt  DateTime?
  sentAt       DateTime?
  
  // Segmentação
  targetAll            Boolean  @default(false)
  targetSegments       Json?    // Critérios de segmentação
  targetSubscriberIds  String[] @default([]) @db.ObjectId // IDs específicos
  
  // Conteúdo personalizado (se diferente do template)
  customSubject     String?
  customHtmlContent String?
  customTextContent String?
  
  // Configurações de envio
  senderName    String  @default("Opus Atlas")
  senderEmail   String  @default("noreply@opusatlas.com")
  replyToEmail  String?
  testEmailSent Boolean @default(false)
  
  // 🆕 CONFIGURAÇÕES AVANÇADAS
  priority      String  @default("normal") // "low", "normal", "high", "urgent"
  deliveryOptions Json? // Opções de entrega (throttling, retry, etc.)
  
  // Estatísticas expandidas
  totalSubscribers    Int @default(0) // Quantos vão receber
  emailsSent          Int @default(0) // Quantos foram enviados
  emailsDelivered     Int @default(0) // Quantos foram entregues
  emailsOpened        Int @default(0) // Quantos foram abertos
  emailsClicked       Int @default(0) // Quantos tiveram cliques
  emailsBounced       Int @default(0) // Quantos retornaram
  emailsComplained    Int @default(0) // Quantos marcaram como spam
  emailsUnsubscribed  Int @default(0) // Quantos cancelaram inscrição
  
  // 🆕 MÉTRICAS AVANÇADAS
  uniqueOpens         Int @default(0) // Aberturas únicas
  uniqueClicks        Int @default(0) // Cliques únicos
  avgEngagementTime   Float? // Tempo médio de engajamento
  topClickedLinks     Json? // Links mais clicados
  deviceStats         Json? // Estatísticas por dispositivo
  locationStats       Json? // Estatísticas por localização
  
  // Taxas calculadas (cache)
  deliveryRate Float? @default(0) // emailsDelivered / emailsSent
  openRate     Float? @default(0) // emailsOpened / emailsDelivered  
  clickRate    Float? @default(0) // emailsClicked / emailsDelivered
  bounceRate   Float? @default(0) // emailsBounced / emailsSent
  spamRate     Float? @default(0) // emailsComplained / emailsDelivered
  unsubscribeRate Float? @default(0) // emailsUnsubscribed / emailsDelivered
  
  // Controle de acesso
  createdBy    String    @db.ObjectId
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  
  // Metadados
  notes        String?
  tags         String[] @default([])
  
  // 🆕 AUDITORIA E COMPLIANCE
  gdprCompliant    Boolean @default(true) // Se está em conformidade com GDPR
  retentionPeriod  Int?    // Período de retenção em dias
  archiveAfter     DateTime? // Data para arquivar automaticamente
  
  // Relações
  template     NewsletterTemplate?       @relation(fields: [templateId], references: [id])
  creator      User                      @relation("NewsletterCampaignCreator", fields: [createdBy], references: [id])
  editor       User?                     @relation("NewsletterCampaignEditor", fields: [lastEditedBy], references: [id])
  sends        NewsletterCampaignSend[]
  events       NewsletterEmailEvent[]
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices atualizados
  @@index([status])
  @@index([scheduledAt])
  @@index([createdBy])
  @@index([sentAt])
  @@index([tags])
  @@index([useCustomTemplate, templateType]) // 🆕 Para filtrar por tipo de template
  @@index([priority, scheduledAt]) // 🆕 Para fila de envio
  @@index([openRate, clickRate]) // 🆕 Para rankings de performance
  @@index([archiveAfter]) // 🆕 Para limpeza automática
  @@map("newsletter_campaigns")
}

// Registro de envios por campanha/subscriber
model NewsletterCampaignSend {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  campaignId   String @db.ObjectId
  subscriberId String @db.ObjectId
  
  // Status do envio
  status       String    @default("pending") // pending, sent, failed
  sentAt       DateTime?
  failureReason String?
  
  // Dados do envio
  emailId      String? // ID do provedor de email (SendGrid, etc.)
  
  // Relações
  campaign     NewsletterCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   NewsletterSubscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices
  @@unique([campaignId, subscriberId])
  @@index([status])
  @@index([sentAt])
  @@map("newsletter_campaign_sends")
}

// Eventos de email (opens, clicks, bounces, etc.)
model NewsletterEmailEvent {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  eventType    EmailEventType
  subscriberId String          @db.ObjectId
  campaignId   String?         @db.ObjectId
  
  // Dados do evento
  timestamp    DateTime        @default(now())
  emailId      String?         // ID do provedor de email
  clickedUrl   String?         // Se foi um click, qual URL
  userAgent    String?
  ipAddress    String?
  location     Json?           // Dados de geolocalização
  
  // Metadata adicional
  eventData    Json?           // Dados específicos do evento
  
  // Relações
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  campaign     NewsletterCampaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Índices
  @@index([eventType, timestamp])
  @@index([subscriberId, eventType])
  @@index([campaignId, eventType])
  @@index([timestamp])
  @@map("newsletter_email_events")
}

// Configurações globais da newsletter
model NewsletterSettings {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
  
  // Metadados
  description String?
  category    String? // "smtp", "design", "automation", etc.
  
  // Controle
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  
  // Relação
  editor       User?     @relation("NewsletterSettingsEditor", fields: [lastEditedBy], references: [id])
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("newsletter_settings")
}

// Modelo para múltiplas listas de teste de email
model TestEmailList {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  // Nome da lista (ex: "Lista VIPs", "Equipe de Teste")  
  description String? // Descrição da lista (ex: "Emails da equipe interna")
  
  // Emails da lista
  emails      String[] @default([]) // Array de emails
  
  // Configurações
  isActive    Boolean  @default(true)  // Lista ativa/inativa
  color       String   @default("#6366f1") // Cor para identificação visual
  
  // Metadados
  totalEmails Int      @default(0) // Cache do total de emails
  lastUsed    DateTime? // Última vez que foi usada para envio
  timesUsed   Int      @default(0) // Quantas vezes foi usada
  
  // Auditoria
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relação
  creator User @relation("TestEmailListCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  
  // Índices
  @@index([createdBy])
  @@index([isActive])
  @@index([name])
  @@map("test_email_lists")
}
model TemplateUsageLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  templateId String   @db.ObjectId
  campaignId String?  @db.ObjectId // Pode ser null para testes
  userId     String   @db.ObjectId
  
  // Dados do uso
  usageType  String   // "campaign", "test", "preview"
  context    Json?    // Contexto adicional do uso
  
  // Métricas do uso
  renderTime Float?   // Tempo de renderização em ms
  variables  Json?    // Variáveis usadas na renderização
  errors     String[] @default([]) // Erros encontrados
  
  // Resultado
  successful Boolean  @default(true)
  emailsSent Int?     // Para campanhas
  
  createdAt DateTime @default(now())
  
  // Relações
  user     User                @relation(fields: [userId], references: [id])
  
  @@index([templateId, createdAt])
  @@index([usageType])
  @@index([successful])
  @@map("template_usage_logs")
}

// 🆕 NOVO MODELO: Fragmentos de template reutilizáveis
model TemplateFragment {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  
  // Conteúdo do fragmento
  htmlContent String
  textContent String?
  variables   String[] @default([])
  
  // Categorização
  category    String   // "header", "footer", "content-block", "cta", etc.
  tags        String[] @default([])
  
  // Configurações
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(false) // Se pode ser usado por outros
  
  // Estatísticas
  timesUsed   Int      @default(0)
  
  // Controle de acesso
  createdBy   String   @db.ObjectId
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relações
  creator     User     @relation(fields: [createdBy], references: [id])
  
  @@index([category, isActive])
  @@index([createdBy])
  @@index([tags])
  @@map("template_fragments")
}