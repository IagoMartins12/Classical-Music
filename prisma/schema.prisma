  creator     User        @relation("AdCreator", fields: [createdBy], references: [id])
  editor      User?       @relation("AdEditor", fields: [lastEditedBy], references: [id])
  instrument  Instrument? @relation(fields: [instrumentId], references: [id])

  // Estatísticas
  stats AdStats[]

  // Índices otimizados para busca única por tipo
  @@unique([placement, targetType, instrumentId], name: "unique_ad_per_type")
  @@index([status, placement])
  @@index([targetType, instrumentId])
  @@index([createdBy])
  @@index([imageQuality])
  @@index([videoQuality])
  @@map("advertisements")
}


