  // 🆕 Configurações de qualidade
  imageQuality  String @default("high") // "high", "medium", "low"
  videoQuality  String @default("high") // "high", "medium", "low"
  
  // Links e ações
  ctaText     String? // Texto do call-to-action
  targetUrl   String? // URL de destino OU número WhatsApp
  linkType    String  @default("url") // "url" ou "whatsapp"
  isExternal  Boolean @default(true)

  // Configurações de exibição
  type      AdType      @default(BANNER)
  placement AdPlacement @default(SIDEBAR_RIGHT)
  status    AdStatus    @default(DRAFT)

