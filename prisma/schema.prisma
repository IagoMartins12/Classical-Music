// This is your Prisma schema file for the classical music encyclopedia project
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums
enum DifficultyLevel {
  null
  UNKNOWN
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL
  EXPRESSIVITY
  PRECISION
}

enum WorkType {
    INDIVIDUAL
    COMPLETE_WORK
    ARRANGEMENT
    COLLECTION
    COLLABORATION
    COMPOSITION
    COLLECTED_WORKS
    COLLECTIONS_WITH
}

// Models
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  gender         String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  Account           Account[]
  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]
  studySessions     StudySession[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Composer {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  fullName        String
  birthDate       String?
  deathDate       String?
  portraitUrl     String?
  epochId         String         @db.ObjectId
  epochName       String?
  bio             String?
  createdAt       DateTime       @default(now())
  permLinkImslp   String?
  imslpId         String?        // IMPORTANTE: usado pelo scraper para matching
  wikipediaLink   String?

  // Primary role
  primaryRoleId   String         @db.ObjectId
  primaryRole     Role           @relation("PrimaryRole", fields: [primaryRoleId], references: [id])

  // Relationships
  epoch           Epoch          @relation(fields: [epochId], references: [id])
  works           Work[]
  favoritedBy     FavoriteComposer[]

  // Additional roles (many-to-many)
  roles           String?

  @@index([name])
  @@index([epochId])
  @@index([fullName])
  @@index([primaryRoleId])
  @@index([imslpId]) // Para busca eficiente pelo scraper

  // ÍNDICES COMPOSTOS
  @@index([name, epochId])
  @@index([epochId, primaryRoleId])
  
  // ÍNDICE para busca de texto
  @@index([name, fullName])
}

model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers Composer[]
  works Work[]

  @@index([name])
}



model Role {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String

  // Composers with this as their primary role
  primaryComposers Composer[]     @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String           @unique
  createdAt DateTime         @default(now())
  users     UserInstrument[]
  works     Work[]
}

model WorkGenre {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  name      String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

}

model Work {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  composerId        String             @db.ObjectId
  instrumentId      String             @db.ObjectId
  epochId           String             @db.ObjectId

  videoUrl          String?
  imslpPermlink     String
  imslpId           String
  opOrCatalog       String?
  compositionYear   String?
  firstPublishDate  String?
  tone              String?
  mediaDuration     String?
  workStyle         String?
  moviment          String?
  categoryNames     String[]        @default([])
  workGenresArr     String[]        @default([])

  dedicateTo             String?
  dedicationComposerLink String?
  instrumentation        String?
  workType               WorkType       @default(INDIVIDUAL)

  isPartOfCollection     Boolean        @default(false)
  parentWorkId           String?        @db.ObjectId
  movementNumber         Int?

  createdAt              DateTime       @default(now())

  // Relations
  composer          Composer        @relation(fields: [composerId], references: [id])
  epoch             Epoch           @relation(fields: [epochId], references: [id])
  instrument        Instrument      @relation(fields: [instrumentId], references: [id])


  parentWork        Work?           @relation("WorkHierarchy", fields: [parentWorkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childWorks        Work[]          @relation("WorkHierarchy")

  annotations       Annotation[]
  favoriteBy        FavoriteWork[]
  wantToLearners    WantToLearn[]
  learners          Learned[]
  studySessions     StudySession[]

  @@index([title])
  @@index([composerId])
  @@index([imslpId])
  @@index([title, composerId])
  @@index([workType])
  @@index([parentWorkId])
  @@index([isPartOfCollection])

   // ÍNDICES COMPOSTOS para filtros combinados
  @@index([composerId, instrumentId])
  @@index([composerId, epochId])
  @@index([instrumentId, epochId])
  @@index([composerId, instrumentId, epochId])
  
  // ÍNDICES para busca de texto
  @@index([opOrCatalog, composerId])

  
  // ÍNDICES para arrays (se suportado pelo MongoDB)
  @@index([categoryNames])
  @@index([workGenresArr])
}




// Join tables
model UserInstrument {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  instrumentId String @db.ObjectId

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

// User-generated content
model Annotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model StudySession {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  workId        String        @db.ObjectId
  date          DateTime      @default(now())
  durationMin   Int // duração em minutos
  metronomeUsed Boolean       @default(false)
  focus         PracticeFocus
  notes         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

// Wishlists and favorites
model WantToLearn {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model Learned {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  learnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteWork {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteComposer {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  composerId String @db.ObjectId

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  composer Composer @relation(fields: [composerId], references: [id], onDelete: Cascade)

  @@unique([userId, composerId])
}