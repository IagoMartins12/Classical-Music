  videoAulaType    String? // "video", "story", "reels", "live"
  videoAulaSource  String? // "youtube", "instagram", "tiktok", "local", "external"
  videoAulaAddedBy String?   @db.ObjectId
  videoAulaAddedAt DateTime?

  // Metadados específicos por tipo
  videoAulaMetadata Json? // { duration?, aspectRatio?, platform?, embedCode? }

  // 🆕 SISTEMA DETALHADO IMSLP (complementar)
  imslpDifficultyLevel  String? // "1", "2", "3"... "12" 
  imslpDifficultySystem String? // "IMSLP", "RCM", "ABRSM", etc.
  imslpDifficultyRating String? // "Lvl 1", "RCM Preparatory B", etc.
  imslpSourceId         String? // ID do IMSLP que tem essa dificuldade

  // 🔄 VERIFICAÇÃO - ATUALIZADA PARA SetNull
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?
  isVerified         Boolean   @default(false)

  // 🔄 CAMPOS PARA RASTREAMENTO - ATUALIZADOS PARA SetNull
  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("UserCreatedWorks", fields: [createdBy], references: [id], onDelete: SetNull)
  isCustom      Boolean @default(false)

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json?

  // 🆕 SISTEMA DE DIFICULDADE IMSLP
  difficultyLevel    String? // "1", "2", "3"... "12"
  difficultySystem   String? // "IMSLP", "RCM", "ABRSM", etc.
  difficultyRating   String? // "Lvl 1", "RCM Preparatory B", etc.
  difficultySourceId String? // ID do IMSLP que tem essa dificuldade (sourceId do WorkScore)

  // 🔄 RELAÇÕES EXISTENTES - ALGUMAS ATUALIZADAS
  composer           Composer             @relation(fields: [composerId], references: [id], onDelete: Cascade) // 🔄 CASCADE quando deletar compositor
  epoch              Epoch                @relation(fields: [epochId], references: [id])
  instrument         Instrument           @relation(fields: [instrumentId], references: [id])
  favoriteScores     FavoriteScore[]
  scoreFavoriteStats ScoreFavoriteStats[]

  annotations    Annotation[]
  favoriteBy     FavoriteWork[]
  wantToLearners WantToLearn[]
  learners       Learned[]
  parentWork         Work?                @relation("WorkCollection", fields: [parentWorkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childWorks         Work[]               @relation("WorkCollection")
  workAnnotations WorkAnnotation[]

  annotationsCount        Int       @default(0)
  helpfulAnnotationsCount Int       @default(0)
  lastAnnotationAt        DateTime?

  cachedScores WorkScore[]

  // ÍNDICES ATUALIZADOS
  @@index([title])
  @@index([opOrCatalog])
  @@index([composerId])
  @@index([imslpId])
  @@index([title, composerId])
  @@index([composerId, title])
  @@index([opOrCatalog, composerId])
  @@index([title, createdAt])
  @@index([composerId, createdAt])
  @@index([workType])
  @@index([composerId, instrumentId])
  @@index([composerId, epochId])
  @@index([instrumentId, epochId])
  @@index([composerId, instrumentId, epochId])
  @@index([categoryNames])
  @@index([workGenresArr])
  @@index([createdBy])
  @@index([isCustom])
  @@index([parentWorkId]) // 🆕 NOVO ÍNDICE
  @@index([composerId, parentWorkId]) // 🆕 ÍNDICE COMPOSTO
  // Índices para mídia
  @@index([mediaSource])
  @@index([lastMediaSearch])
  @@index([spotifyTrackId])
  @@index([youtubeVideoId])
  @@index([videoAulaType])
  @@index([videoAulaSource])
  // ÍNDICES ATUALIZADOS PARA MÍDIA
  @@index([spotifyDisplayTitle])
  @@index([spotifyDuration])
  @@index([spotifyThumbnail])
  @@index([difficultyLevel]) // Enum original
  @@index([imslpDifficultyLevel]) // Níveis IMSLP
  @@index([imslpDifficultySystem])
  @@index([difficultyLevel, imslpDifficultyLevel]) // Combinado
  @@index([instrumentId, difficultyLevel])
  @@index([instrumentId, imslpDifficultyLevel])
  @@index([composerId, difficultyLevel])
}

