// schema.prisma - Schema otimizado com sistema de cache de partituras

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums existentes
enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL
  EXPRESSIVITY
  PRECISION
  SIGHT_READING
  MEMORIZATION
  PERFORMANCE
  REVIEW
}

enum WorkType {
  INDIVIDUAL
  COMPLETE_WORK
  ARRANGEMENT
  COLLECTION
  COLLABORATION
  COMPOSITION
  COLLECTED_WORKS
  COLLECTIONS_WITH
}

enum UserType {
  MUSIC_STUDENT
  CASUAL_USER
  PROFESSIONAL
  TEACHER
}

enum AccountProvider {
  GOOGLE
  EMAIL
  FACEBOOK
}

enum AnnotationType {
  TEXT_NOTE
  HIGHLIGHT
  DRAWING
  BOOKMARK
  FINGERING
  BOWINGS
  DYNAMICS
  TEMPO_MARK
}

enum IMSLPScoreType {
  SCORES
  PARTS
  ARRANGEMENTS
  LIBRETTOS
  OTHERS
  SOURCES
}

// 🆕 Novos enums para sistema de cache
enum ScoreSource {
  IMSLP    // Do IMSLP
  CUSTOM   // Adicionado manualmente
  UPLOAD   // Upload do usuário
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// 🆕 Novos enums para anotações musicais
enum AnnotationCategory {
  TECHNIQUE        // Técnica (dedilhado, articulação, etc.)
  INTERPRETATION   // Interpretação (dinâmica, fraseado, etc.)
  THEORY          // Teoria (harmonia, forma, análise)
  PRACTICE_TIP    // Dicas de estudo
  PERFORMANCE     // Performance e palco
  HISTORICAL      // Contexto histórico
  GENERAL         // Anotação geral
}

enum AnnotationDifficulty {
  BEGINNER         // Para iniciantes
  INTERMEDIATE     // Para nível intermediário  
  ADVANCED         // Para avançados
  ALL_LEVELS       // Para todos os níveis
}

enum AnnotationScope {
  SPECIFIC_MEASURE    // Compasso específico
  SECTION            // Seção da obra
  MOVEMENT           // Movimento inteiro
  ENTIRE_WORK        // Obra inteira
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  gender         String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role Int @default(0)

  userType            UserType?
  onboardingCompleted Boolean   @default(false)

  city    String?
  state   String?
  country String?

  favoriteComposerId String? @db.ObjectId
  favoriteEpochId    String? @db.ObjectId

  experienceLevel     DifficultyLevel @default(BEGINNER)
  practiceTimePerWeek Int?

  profilePublic Boolean @default(true)
  showLocation  Boolean @default(false)

  practiceReminders Boolean @default(true)
  progressTracking  Boolean @default(true)
  publicProgress    Boolean @default(false)

  totalStudyTime    Int     @default(0)
  currentStreak     Int     @default(0)
  longestStreak     Int     @default(0)

  studyModeSettings Json?

  // 🆕 Anotações relacionadas
  workAnnotations     WorkAnnotation[]
  annotationVotes     AnnotationHelpfulVote[]
  annotationReplies   AnnotationReply[]
  
  // 🆕 Configurações de anotações
  annotationPreferences Json? // Preferências de exibição, notificações, etc.
  
  // 🆕 Estatísticas de contribuição
  helpfulAnnotationsCount Int @default(0) // Cache de anotações úteis
  totalAnnotationsCount   Int @default(0) // Cache total de anotações
  expertInstruments       String[] @default([]) // Instrumentos que o usuário é expert

  // Relations
  accounts Account[]
  sessions Session[]
  selectedScores UserSelectedScore[]

  favoriteComposer Composer? @relation("FavoriteComposer", fields: [favoriteComposerId], references: [id])
  favoriteEpoch    Epoch?    @relation("FavoriteEpoch", fields: [favoriteEpochId], references: [id])

  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]
  studySessions     StudySession[]
  learningGoals     LearningGoal[]
  
  pdfAnnotations    PdfAnnotation[]
  scoreBookmarks    ScoreBookmark[]

  @@index([userType])
  @@index([onboardingCompleted])
}

// 🆕 Model principal para cache de partituras
model WorkScore {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  workId   String      @db.ObjectId
  sourceId String      // ID da partitura na fonte (IMSLP ID, custom ID, etc.)
  source   ScoreSource @default(IMSLP)
  
  // Dados básicos da partitura
  title       String
  downloadUrl String?
  fileSize    String?
  pageCount   String?
  fileFormat  String   @default("PDF")
  
  // Metadados IMSLP
  editor       String?
  publisher    String?
  copyright    String?
  thumbnailUrl String?
  uploadDate   String?
  uploader     String?
  notes        String?
  
  // Classificação e organização
  type        IMSLPScoreType @default(SCORES)
  groupIndex  Int?           @default(0)
  groupTitle  String?
  
  // Métricas do IMSLP
  rating        Float?
  ratingsCount  Int?
  downloadCount Int?
  
  // Dados customizados (para partituras não-IMSLP)
  isCustom     Boolean @default(false)
  uploadedBy   String? // ID do usuário que fez upload
  customData   Json?   // Dados extras específicos
  
  // Cache e controle
  isActive       Boolean           @default(true)
  isVerified     Boolean           @default(false)
  lastVerified   DateTime          @default(now())
  lastAccessed   DateTime          @default(now())
  accessCount    Int               @default(0)
  priority       Int               @default(0) // Para ordenação
  expiresAt      DateTime?         // TTL do cache
  cacheVersion   String            @default("1.0")
  
  // Status de processamento
  processingStatus ProcessingStatus @default(PENDING)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  // Índices otimizados para performance
  @@unique([workId, sourceId, source], name: "workId_sourceId_source")
  @@index([workId, isActive, priority])
  @@index([workId, type, groupIndex])
  @@index([source, processingStatus])
  @@index([isActive, expiresAt])
  @@index([lastAccessed, isActive])
  @@index([priority, createdAt])
  @@map("work_scores")
}

// 🆕 Model para logs de processamento em background
model ScoreProcessingLog {
  id       String           @id @default(auto()) @map("_id") @db.ObjectId
  workId   String           @db.ObjectId
  action   String           // Tipo de ação: 'cache_scores', 'cache_scores_background', 'maintenance', etc.
  status   ProcessingStatus @default(PENDING)
  
  // Dados de execução
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?      // Duração em milissegundos
  
  // Dados da fila
  priority     Int       @default(5) // 1-10 (10 = máxima prioridade)
  scheduledFor DateTime? // Para agendamento
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  
  // Estatísticas de processamento
  itemsTotal   Int? // Total de itens a processar
  itemsSuccess Int? // Itens processados com sucesso
  itemsFailed  Int? // Itens que falharam
  itemsSkipped Int? // Itens que foram pulados
  
  // Dados adicionais
  details Json? // Dados específicos do job
  error   String? // Mensagem de erro se falhou
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relação
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  // Índices para performance
  @@index([status, priority, scheduledFor])
  @@index([workId, action, status])
  @@index([status, createdAt])
  @@index([action, status])
  @@map("score_processing_logs")
}

// Models existentes (mantendo todos)

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Composer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  fullName      String
  otherName     String?  // Nome alternativo (contentSub)
  
  // 🆕 Nomes alternativos da página IMSLP
  alternativeNames    String?  // 🆕 Nomes alternativos/Transliterações
  namesInOtherLangs   String?  // 🆕 Nome em outras línguas  
  pseudonyms          String?  // 🆕 Pseudônimos
  
  // Datas melhoradas - podem conter dia/mês/ano
  birthDate     String?  // Ex: "31 de janeiro de 1797", "1797", "January 31, 1797"
  deathDate     String?  // Ex: "28 de novembro de 1828", "1828", "November 28, 1828"
  
  portraitUrl   String?
  epochId       String   @db.ObjectId
  epochName     String?
  bio           String?
  
  // 🆕 Informações detalhadas da página IMSLP
  diverseInfo         String?  // 🆕 Informação diversa (biografia detalhada)
  externalLinks       String?  // 🆕 Links externos úteis
  
  // Dados IMSLP
  permLinkImslp String?
  imslpId       String?
  wikipediaLink String?
  
  // 🆕 Dados estatísticos e geográficos (mantidos)
  nationality          String?  // País/nacionalidade (ex: "German", "Austrian", "Brazilian")
  instruments          String?  // Instrumentos associados (ex: "Piano, Violin, Orchestra")
  
  // 🆕 Categorias e classificações IMSLP
  imslpCategories      String?  // 🔄 VOLTOU - Categorias do IMSLP (ex: "Romantic composers, German composers, Pianists")
  
  // 🆕 Metadados da página IMSLP
  lastModifiedImslp    String?  // Data da última modificação no IMSLP
  pageStatus           String?  // Status da página: "complete", "stub", "needs_work"
  pageQuality          String?  // Qualidade da página: "high", "medium", "low"
  
  // 🆕 Dados de cache e verificação
  lastVerified         DateTime @default(now())
  dataCompleteness     Float?   // Porcentagem de completude dos dados (0-100)
  hasValidImage        Boolean  @default(false) // Se tem imagem válida (não placeholder)
  
  // Campos existentes
  primaryRoleId String @db.ObjectId
  primaryRole   Role   @relation("PrimaryRole", fields: [primaryRoleId], references: [id])
  roles         String?
  createdAt     DateTime @default(now())

  // Relações existentes
  epoch       Epoch              @relation(fields: [epochId], references: [id])
  works       Work[]
  favoritedBy FavoriteComposer[]
  favoriteByUsers User[] @relation("FavoriteComposer")

  // 🆕 Índices otimizados
  @@index([name])
  @@index([epochId])
  @@index([fullName])
  @@index([otherName])             // Índice para nome alternativo
  @@index([alternativeNames])      // 🆕 Índice para nomes alternativos
  @@index([imslpCategories])       // 🔄 VOLTOU - Índice para categorias IMSLP
  @@index([primaryRoleId])
  @@index([imslpId])
  @@index([nationality])
  @@index([birthDate])             // Para filtros por período
  @@index([deathDate])             // Para filtros por período
  @@index([hasValidImage])
  @@index([name, epochId])
  @@index([epochId, primaryRoleId])
  @@index([name, fullName])
  @@index([nationality, epochId])
}
model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers       Composer[]
  works           Work[]
  favoriteByUsers User[]     @relation("FavoriteEpoch")

  @@index([name])
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  primaryComposers Composer[] @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String           @unique
  category   String?
  difficulty String?
  createdAt  DateTime         @default(now())
  users      UserInstrument[]
  works      Work[]

  @@index([category])
}

model WorkGenre {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  composerId   String @db.ObjectId
  instrumentId String @db.ObjectId
  epochId      String @db.ObjectId

  videoUrl         String?
  imslpPermlink    String
  imslpId          String
  opOrCatalog      String?
  compositionYear  String?
  firstPublishDate String?
  tone             String?
  mediaDuration    String?
  workStyle        String?
  moviment         String?
  categoryNames    String[] @default([])
  workGenresArr    String[] @default([])

  dedicateTo             String?
  dedicationComposerLink String?
  instrumentation        String?
  workType               WorkType @default(INDIVIDUAL)

  isPartOfCollection Boolean @default(false)
  parentWorkId       String? @db.ObjectId
  movementNumber     Int?

  createdAt DateTime @default(now())

  subtitle             String?
  timeSignature        String?
  tempoMarking         String?
  movementsDetailed    Json?
  imslpTags            String[] @default([])
  difficultyLevel      DifficultyLevel?

  composer   Composer   @relation(fields: [composerId], references: [id])
  epoch      Epoch      @relation(fields: [epochId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  parentWork Work?  @relation("WorkHierarchy", fields: [parentWorkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childWorks Work[] @relation("WorkHierarchy")

  annotations    Annotation[]
  favoriteBy     FavoriteWork[]
  wantToLearners WantToLearn[]
  learners       Learned[]
  studySessions  StudySession[]
  selectedScores UserSelectedScore[]

  pdfAnnotations PdfAnnotation[]
  scoreBookmarks ScoreBookmark[]
  
  // 🆕 Anotações relacionadas
  workAnnotations WorkAnnotation[]
  
  // 🆕 Estatísticas de anotações (cache para performance)
  annotationsCount        Int @default(0)
  helpfulAnnotationsCount Int @default(0)
  lastAnnotationAt        DateTime?

  // 🆕 Relações com sistema de cache
  cachedScores       WorkScore[]
  processingLogs     ScoreProcessingLog[]

  @@index([title])
  @@index([composerId])
  @@index([imslpId])
  @@index([title, composerId])
  @@index([workType])
  @@index([parentWorkId])
  @@index([isPartOfCollection])
  @@index([composerId, instrumentId])
  @@index([composerId, epochId])
  @@index([instrumentId, epochId])
  @@index([composerId, instrumentId, epochId])
  @@index([opOrCatalog, composerId])
  @@index([categoryNames])
  @@index([workGenresArr])
}

// Outros models permanecem iguais...

model UserInstrument {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  instrumentId String @db.ObjectId

  level      DifficultyLevel @default(BEGINNER)
  isPrimary  Boolean         @default(false)
  isLearning Boolean         @default(true)
  startedAt  DateTime        @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

model Annotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  content   String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model PdfAnnotation {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  userId   String         @db.ObjectId
  workId   String         @db.ObjectId
  scoreId  String
  
  type     AnnotationType
  content  String?
  
  page     Int
  x        Float
  y        Float
  width    Float?
  height   Float?
  
  color    String?
  fontSize Int?
  strokeWidth Float?
  drawing  Json?
  
  measure  Int?
  beat     Float?
  voice    Int?
  
  isPublic Boolean       @default(false)
  tags     String[]      @default([])
  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@index([userId, workId, scoreId])
  @@index([workId, scoreId, page])
  @@index([type])
}

model ScoreBookmark {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  workId      String   @db.ObjectId
  scoreId     String
  
  title       String
  description String?
  color       String   @default("#3B82F6")
  
  page        Int
  measure     Int?
  system      Int?
  
  x           Float?
  y           Float?
  
  sortOrder   Int      @default(0)
  
  isPublic    Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@index([userId, workId, scoreId])
  @@index([workId, scoreId])
  @@index([sortOrder])
}

model StudySession {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  workId        String        @db.ObjectId
  scoreId       String?
  
  date          DateTime      @default(now())
  durationMin   Int
  
  metronomeUsed Boolean       @default(false)
  tempoMarking  String?
  focus         PracticeFocus
  notes         String?
  rating        Int?
  
  sectionsWorked String[]     @default([])
  challenges     String?
  breakthroughs  String?
  
  instrument     String?
  location       String?
  mood           Int?
  energy         Int?

  metronomeSettings Json?
  selectedScore     Json?
  studyNotes        String?
  practiceGoals     String[]  @default([])
  technicalFocus    String[]  @default([])
  expressiveFocus   String[]  @default([])
  precisionFocus    String[]  @default([])
  
  postPracticeRating Int?
  postPracticeNotes  String?
  nextSessionGoals   String[] @default([])
  
  pauseCount        Int       @default(0)
  restartCount      Int       @default(0)
  sectionsRepeated  Json?
  
  pagesViewed       Int[]     @default([])
  annotationsCreated Int      @default(0)
  bookmarksCreated   Int      @default(0)
  pdfZoomChanges     Int      @default(0)
  
  pdfSettings       Json?
  windowLayout      Json?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([workId, date])
  @@index([userId, workId])
  @@index([scoreId])
}

model WantToLearn {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  workId   String   @db.ObjectId
  priority Int      @default(0)
  addedAt  DateTime @default(now())

  notes            String?        
  targetDate       DateTime?      
  estimatedStudyTime Int?         
  difficulty       DifficultyLevel? 
  reminder         Boolean        @default(false) 
  reminderFrequency String?       
  
  motivation       String?        
  context          String?        
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, priority])
  @@index([targetDate])
}

model Learned {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  learnedAt DateTime @default(now())
  mastery   Int      @default(0)

  studyStartDate    DateTime?     
  studyDuration     Int?          
  notes             String?       
  wouldRecommend    Boolean       @default(true) 
  publicPerformance Boolean       @default(false) 
  lastPracticed     DateTime?     
  
  difficulty        DifficultyLevel? 
  enjoyment         Int?          
  technicalChallenges String?     
  musicalInsights   String?       
  
  performanceCount  Int           @default(0) 
  bestPerformance   String?       
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, mastery])
  @@index([learnedAt])
  @@index([lastPracticed])
}

model UserSelectedScore {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  workId    String
  
  imslpScoreId   String
  title          String
  downloadUrl    String
  fileSize       String?
  pageCount      String?
  fileFormat     String   @default("PDF")
  
  editor         String?
  publisher      String?
  copyright      String?
  thumbnailUrl   String?
  uploadDate     String?
  uploader       String?
  notes          String?
  
  type           IMSLPScoreType  @default(SCORES)
  groupIndex     Int?
  groupTitle     String?
  
  rating         Float?
  ratingsCount   Int?
  downloadCount  Int?
  
  lastVerified   DateTime @default(now())
  isActive       Boolean  @default(true)
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work           Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@unique([userId, workId, imslpScoreId])
  @@index([userId, workId])
  @@index([workId])
  @@map("user_selected_scores")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningGoal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String   
  description String?
  targetDate  DateTime?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  
  workIds     String[] @db.ObjectId @default([])
  
  progressNotes String?
  milestones    String[] @default([]) 
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, targetDate])
  @@index([isCompleted])
}

model FavoriteWork {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteComposer {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  composerId String @db.ObjectId

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  composer Composer @relation(fields: [composerId], references: [id], onDelete: Cascade)

  @@unique([userId, composerId])
}

model WorkAnnotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  workId    String   @db.ObjectId
  
  // Conteúdo da anotação
  title       String              // Título/resumo da anotação
  content     String              // Conteúdo principal
  category    AnnotationCategory  @default(GENERAL)
  
  // Localização na obra
  scope           AnnotationScope  @default(ENTIRE_WORK)
  measureStart    Int?             // Compasso inicial (se específico)
  measureEnd      Int?             // Compasso final (se range)
  movement        String?          // Nome do movimento
  section         String?          // Nome da seção (ex: "Exposição", "Desenvolvimento")
  pageNumber      Int?             // Página da partitura (se aplicável)
  
  // Metadata musical
  hand            String?          // "left", "right", "both"
  voice           String?          // "soprano", "alto", "tenor", "bass"
  instrument      String?          // Instrumento específico (para obras de conjunto)
  
  // Classificação e utilidade
  difficulty      AnnotationDifficulty @default(ALL_LEVELS)
  tags            String[]         @default([])
  
  // Interação social
  isPublic        Boolean          @default(true)
  isVerified      Boolean          @default(false)  // Verificado por moderador/expert
  helpfulCount    Int              @default(0)      // Quantos acharam útil
  viewCount       Int              @default(0)      // Visualizações
  
  // Moderação
  isFlagged       Boolean          @default(false)
  flagReason      String?
  moderatedBy     String?          @db.ObjectId
  moderatedAt     DateTime?
  
  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  // Relações de interação
  helpfulVotes    AnnotationHelpfulVote[]
  replies         AnnotationReply[]
  
  // Índices otimizados
  @@index([workId, isPublic, category])
  @@index([workId, scope, measureStart])
  @@index([userId, createdAt])
  @@index([category, difficulty])
  @@index([isPublic, helpfulCount])
  @@index([tags])
  @@index([isVerified, isPublic])
  @@map("work_annotations")
}

// 🆕 Model para votos de utilidade
model AnnotationHelpfulVote {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  annotationId String @db.ObjectId
  isHelpful    Boolean @default(true)
  createdAt    DateTime @default(now())
  
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotation WorkAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, annotationId])
  @@index([annotationId, isHelpful])
  @@map("annotation_helpful_votes")
}

// 🆕 Model para respostas às anotações
model AnnotationReply {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  annotationId String @db.ObjectId
  
  content      String
  isPublic     Boolean @default(true)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotation WorkAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  
  @@index([annotationId, createdAt])
  @@index([userId, createdAt])
  @@map("annotation_replies")
}

model AnnotationStats {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Período das estatísticas
  period    String   // "daily", "weekly", "monthly"
  date      DateTime
  
  // Estatísticas gerais
  totalAnnotations      Int @default(0)
  newAnnotations        Int @default(0)
  totalHelpfulVotes     Int @default(0)
  activeUsers           Int @default(0)
  
  // Top anotações por categoria
  topByTechnique        Json? // IDs das top anotações
  topByInterpretation   Json?
  topByPracticeTip      Json?
  
  // Top obras com mais anotações
  topWorksAnnotated     Json?
  
  createdAt DateTime @default(now())
  
  @@unique([period, date])
  @@map("annotation_stats")
}