// schema.prisma - Schema atualizado com sistema completo de cascade deletions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums existentes (mantendo todos iguais)
enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL
  EXPRESSIVITY
  PRECISION
  SIGHT_READING
  MEMORIZATION
  PERFORMANCE
  REVIEW
}

enum WorkType {
  INDIVIDUAL
  COMPLETE_WORK
  ARRANGEMENT
  COLLECTION
  COLLABORATION
  COMPOSITION
  COLLECTED_WORKS
  COLLECTIONS_WITH
}

enum UserType {
  MUSIC_STUDENT
  CASUAL_USER
  PROFESSIONAL
  TEACHER
}

enum AnnotationType {
  TEXT_NOTE
  HIGHLIGHT
  DRAWING
  BOOKMARK
  FINGERING
  BOWINGS
  DYNAMICS
  TEMPO_MARK
}

enum IMSLPScoreType {
  SCORES
  PARTS
  ARRANGEMENTS
  LIBRETTOS
  OTHERS
  SOURCES
}

enum ScoreSource {
  IMSLP // Do IMSLP
  CUSTOM // Adicionado manualmente
  UPLOAD // Upload do usuário
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AnnotationCategory {
  TECHNIQUE // Técnica (dedilhado, articulação, etc.)
  INTERPRETATION // Interpretação (dinâmica, fraseado, etc.)
  THEORY // Teoria (harmonia, forma, análise)
  PRACTICE_TIP // Dicas de estudo
  PERFORMANCE // Performance e palco
  HISTORICAL // Contexto histórico
  GENERAL // Anotação geral
}

enum AnnotationDifficulty {
  BEGINNER // Para iniciantes
  INTERMEDIATE // Para nível intermediário  
  ADVANCED // Para avançados
  ALL_LEVELS // Para todos os níveis
}

enum AnnotationScope {
  SPECIFIC_MEASURE // Compasso específico
  SECTION // Seção da obra
  MOVEMENT // Movimento inteiro
  ENTIRE_WORK // Obra inteira
}

enum AdType {
  BANNER
  VIDEO
  CARD
  SIDEBAR
  NATIVE
  POPUP
}

enum AdPlacement {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
  CONTENT_TOP
  CONTENT_BOTTOM
  BETWEEN_CONTENT
  FOOTER
  MODAL
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  SCHEDULED
  EXPIRED
}

enum AdTargetType {
  GENERAL // Publicidade geral
  INSTRUMENT // Por instrumento específico
  USER_LEVEL // Por nível do usuário (geral, professor, estudante)
}

enum AdUserLevel {
  ALL // Todos os usuários
  STUDENT // Apenas estudantes (role 0)
  TEACHER // Apenas professores (role 1)
}

enum SubscriptionStatus {
  PENDING // Aguardando confirmação (double opt-in)
  ACTIVE // Inscrito ativo
  UNSUBSCRIBED // Cancelou inscrição
  BOUNCED // Email com bounce
  BLOCKED // Bloqueado por spam/abuse
}

enum EmailTemplateType {
  WELCOME // Email de boas-vindas
  WEEKLY_DIGEST // Resumo semanal
  NEW_COMPOSER // Novo compositor adicionado
  NEW_WORK // Nova obra adicionada
  STUDY_REMINDER // Lembrete de estudo
  CUSTOM_CAMPAIGN // Campanha personalizada
  UNSUBSCRIBE // Confirmação de cancelamento
  UNSUBSCRIBE_CONFIRMATION
  PASSWORD_RESET
  ACCOUNT_CONFIRMATION
}

enum CampaignStatus {
  DRAFT // Rascunho
  SCHEDULED // Agendada
  SENDING // Enviando
  SENT // Enviada
  PAUSED // Pausada
  CANCELLED // Cancelada
  FAILED // Falhou
}

enum EmailEventType {
  SENT // Email enviado
  DELIVERED // Entregue
  OPENED // Aberto
  CLICKED // Clicou em link
  BOUNCED // Retornou (bounce)
  COMPLAINED // Marcado como spam
  UNSUBSCRIBED // Cancelou inscrição
}

enum TokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
  NEWSLETTER_CONFIRMATION
  NEWSLETTER_UNSUBSCRIBE 
  EMAIL_CHANGE
  TEACHER_INVITATION_ACCEPT
  TEACHER_INVITATION_DECLINE
  STUDENT_INVITATION_ACCEPT
  STUDENT_INVITATION_DECLINE
  STUDENT_INVITATION
}

enum StudentInviteStatus {
  PENDING // Convite enviado, aguardando resposta
  ACCEPTED // Convite aceito
  DECLINED // Convite recusado
  EXPIRED // Convite expirado
}

// ENUMS PARA O SISTEMA PROFESSOR-ALUNO
enum LessonStatus {
  SCHEDULED // Agendada
  COMPLETED // Concluída
  CANCELLED // Cancelada
  NO_SHOW // Aluno faltou
  RESCHEDULED // Reagendada
}

enum LessonType {
  INDIVIDUAL // Aula individual
  GROUP // Aula em grupo
  THEORY // Teoria musical
  PRACTICE // Aula prática
  MASTERCLASS // Masterclass
}

enum RecurrenceType {
  WEEKLY // Semanal
  BIWEEKLY // Quinzenal
  MONTHLY // Mensal
  TWICE_WEEKLY // 2x por semana
  NONE // Sem recorrência
}

enum StudentStatus {
  ACTIVE // Ativo
  INACTIVE // Inativo
  PAUSED // Pausado temporariamente
  TRIAL // Período de teste
}

enum TeacherStatus {
  ACTIVE // Ativo
  INACTIVE // Inativo
  PENDING // Aguardando aprovação
}

enum AssignmentStatus {
  PENDING // Pendente
  IN_PROGRESS // Em andamento
  COMPLETED // Concluída
  OVERDUE // Atrasada
}

enum NotificationType {
  // NOTIFICAÇÕES AUTOMÁTICAS (mantidas no check/route.ts)
  LESSON_STARTING_SOON     // 30min antes da aula
  LESSON_TOMORROW          // 24h antes da aula
  ASSIGNMENT_DUE_SOON     // 2h antes do vencimento
  ASSIGNMENT_DUE_TOMORROW // 24h antes do vencimento
  ASSIGNMENT_OVERDUE      // Tarefa já atrasada
  LESSON_STATUS_PENDING    // Aula passou sem status atualizado
  
  // NOTIFICAÇÕES PARA ESTUDANTES (eventos reais)
  TEACHER_GAVE_FEEDBACK     // Professor deu feedback na tarefa
  LESSON_CANCELLED_BY_TEACHER // Professor cancelou aula
  LESSON_RESCHEDULED_BY_TEACHER // Professor reagendou aula
  LESSON_MARKED_NO_SHOW     // Professor marcou falta
  NEW_ASSIGNMENT_CREATED    // Professor criou nova tarefa
  ASSIGNMENT_UPDATED_BY_TEACHER // Professor alterou tarefa
  NEW_LESSON_SCHEDULED      // Nova aula agendada (só PAI ou solo)
  
  // 🆕 NOVA: Parabéns por aceitar ser aluno
  WELCOME_NEW_STUDENT       // Parabéns por aceitar ser aluno de um professor
  
  // NOTIFICAÇÕES PARA PROFESSORES (eventos reais)
  STUDENT_SUBMITTED_ASSIGNMENT // Aluno enviou submissão
  STUDENT_COMPLETED_ASSIGNMENT // Aluno completou tarefa
  STUDENT_GAVE_LESSON_FEEDBACK // Aluno deu feedback na aula
  STUDENT_INFORMED_ABSENCE     // Aluno informou ausência
  STUDENT_REQUESTED_RESCHEDULE // Aluno solicitou reagendamento
  
  // 🆕 NOVAS: Para professores
  WELCOME_NEW_TEACHER       // Parabéns por se tornar professor
  STUDENT_DECLINED_INVITE   // Aluno declinou convite para ser aluno
  STUDENT_ACCEPTED_INVITE
  // NOTIFICAÇÕES ANTIGAS (manter para compatibilidade)
  LESSON_NO_SHOW
  ASSIGNMENT_FEEDBACK_NEEDED  // 🗑️ SERÁ REMOVIDA do check/route.ts
  ASSIGNMENT_COMPLETED
  STUDENT_INVITE_PENDING
  STUDENT_MULTIPLE_LATE
  NEW_STUDENT_FEEDBACK        // 🗑️ SERÁ REMOVIDA do check/route.ts
  WEEKLY_REPORT_AVAILABLE
  PRACTICE_REMINDER
  SYSTEM_MAINTENANCE
  GENERAL_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW       // Azul - informativo
  MEDIUM    // Amarelo - importante 
  HIGH      // Vermelho - urgente
  CRITICAL  // Vermelho piscando - crítico
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  EXPIRED
}

enum SchoolActivityAction {
  // AÇÕES DO PROFESSOR
  STUDENT_ADDED             // Cadastrou novo aluno
  LESSON_CREATED           // Criou nova aula
  LESSON_UPDATED           // Editou aula existente
  LESSON_STATUS_CHANGED    // Alterou status da aula (cancelou, deu falta, remarcou)
  ASSIGNMENT_CREATED       // Criou nova tarefa
  ASSIGNMENT_UPDATED       // Editou tarefa
  ASSIGNMENT_FEEDBACK_GIVEN // Deu feedback e concluiu tarefa
  LESSON_NOTES_ADDED       // Adicionou anotações na aula
  TEACHER_PROFILE_UPDATED  // Alterou dados do perfil de professor
  USER_PROFILE_UPDATED     // Alterou dados do perfil de usuário

  // AÇÕES DO ALUNO
  ASSIGNMENT_SUBMISSION    // Enviou video/arquivo na tarefa
  ASSIGNMENT_COMPLETED    // Completou tarefa
  LESSON_FEEDBACK_GIVEN   // Deu feedback de aula
  LESSON_RESCHEDULE_REQUESTED // Solicitou reagendamento
  LESSON_ABSENCE_INFORMED  // Informou ausência
  LESSON_COMPLETED        // Concluiu aula
  STUDENT_PROFILE_UPDATED // Alterou perfil de aluno
}

enum AchievementCategory {
  LEARNING      // Conquistas de aprendizado
  FAVORITES     // Conquistas de favoritos  
  ANNOTATIONS   // Conquistas de anotações
  GENERAL       // Conquistas gerais
  SOCIAL        // Conquistas sociais
  MILESTONE     // Conquistas de marco
}

enum AchievementRarity {
  COMMON        // Bronze - 10 XP
  RARE          // Prata - 25 XP  
  EPIC          // Ouro - 50 XP
  LEGENDARY     // Diamante - 100 XP
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role Int @default(0) //0 = usuario comum 2, 1 = admin 2 = super admin

  userType            UserType?
  onboardingCompleted Boolean   @default(false)

  city             String?
  state            String?
  country          String?
  // 🆕 CAMPOS DE TELEFONE
  phone            String? // Telefone completo em formato E.164 (+5511999999999)
  phoneCountryCode String? // Código do país (BR, US, etc.)
  phoneNumber      String? // Apenas o número sem código do país

  favoriteComposerId String? @db.ObjectId
  favoriteEpochId    String? @db.ObjectId

  experienceLevel     DifficultyLevel @default(BEGINNER)
  practiceTimePerWeek Int?

  profilePublic Boolean @default(true)
  showLocation  Boolean @default(false)

  // Anotações relacionadas
  workAnnotations   WorkAnnotation[]
  annotationVotes   AnnotationHelpfulVote[]
  verifiedComposers Composer[]              @relation("VerifiedComposers")

  // Estatísticas de contribuição
  helpfulAnnotationsCount Int @default(0) // Cache de anotações úteis
  totalAnnotationsCount   Int @default(0) // Cache total de anotações

  // 🔄 RELAÇÕES DE MODERAÇÃO - ATUALIZADAS COM CASCADE
  reportedUploads  UploadModeration[] @relation("ReportedUploads")
  moderatedUploads UploadModeration[] @relation("ModeratedUploads")
  uploadHistory    UploadHistory[]
  generatedReports GeneratedReport[]  @relation("GeneratedReports")
  notifications Notification[] @relation("UserNotifications")
  schoolActivities SchoolActivity[] @relation("UserSchoolActivities")
  achievements        UserAchievement[]     @relation("UserAchievements") 
  achievementProgress AchievementProgress[] @relation("AchievementProgress")
  
  // 🆕 CACHE DE XP (opcional)
  totalXP Int @default(0) // Cache do XP total do usuário
  // Estatísticas de upload
  totalUploads Int @default(0)
  uploadScore  Int @default(0) // Score baseado na qualidade dos uploads

  // Relations
  accounts Account[]
  sessions Session[]
  tokens   UserToken[]

  isTeacher Boolean @default(false)
  isStudent Boolean @default(false)

  // Relações:
  teacherProfile Teacher?
  studentProfile Student?

  // 🔄 RELAÇÕES DE CRIAÇÃO - ATUALIZADAS PARA SetNull
  createdWorks     Work[]      @relation("UserCreatedWorks")
  createdComposers Composer[]  @relation("UserCreatedComposers")
  createdScores    WorkScore[] @relation("UserCreatedScores")

  favoriteComposer Composer? @relation("FavoriteComposer", fields: [favoriteComposerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favoriteEpoch    Epoch?    @relation("FavoriteEpoch", fields: [favoriteEpochId], references: [id])

  // 🔄 RELAÇÕES DE ANÚNCIOS - ATUALIZADAS PARA SetNull
  adStats AdStats[] @relation("AdStatsUser")

  // 🔄 RELAÇÕES DE NEWSLETTER - ATUALIZADA COM CASCADE
  newsletterSubscription NewsletterSubscriber? @relation("NewsletterSubscriber")

  favoriteScores FavoriteScore[]

  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]

  @@index([userType])
  @@index([onboardingCompleted])
  @@index([uploadScore])
}

model WorkScore {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  workId   String      @db.ObjectId
  sourceId String // ID da partitura na fonte (IMSLP ID, custom ID, etc.)
  source   ScoreSource @default(IMSLP)

  // Dados básicos da partitura
  title       String
  downloadUrl String?
  fileSize    String?
  pageCount   String?
  fileFormat  String  @default("PDF")

  // Metadados IMSLP
  editor       String?
  publisher    String?
  copyright    String?
  thumbnailUrl String?
  uploadDate   String?
  uploader     String?
  notes        String?

  // Classificação e organização
  type       IMSLPScoreType @default(SCORES)
  groupIndex Int?           @default(0)
  groupTitle String?

  // Métricas do IMSLP
  rating        Float?
  ratingsCount  Int?
  downloadCount Int?

  // 🔄 RELAÇÃO COM USUÁRIO CRIADOR - ATUALIZADA PARA SetNull
  createdByUser User? @relation("UserCreatedScores", fields: [uploadedBy], references: [id], onDelete: SetNull)

  // 🔄 RELAÇÕES ATUALIZADAS PARA SetNull
  wantToLearnSelections WantToLearn[] @relation("WantToLearnSelectedScore")
  learnedSelections     Learned[]     @relation("LearnedSelectedScore")

  // Campos de qualidade e verificação
  dataQuality        String? // "high", "medium", "low"
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json? // Histórico de edições

  // Campos técnicos melhorados
  qualityScore Int? // Score de qualidade (1-100)

  // Dados customizados (para partituras não-IMSLP)
  isCustom   Boolean @default(false)
  uploadedBy String? // ID do usuário que fez upload
  customData Json? // Dados extras específicos

  // Cache e controle
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  lastVerified DateTime @default(now())
  lastAccessed DateTime @default(now())
  accessCount  Int      @default(0)

  // Campos para sistema incremental
  imslpTotalCounts String? // JSON com totais reais do IMSLP por tipo

  // Status de processamento
  processingStatus ProcessingStatus @default(PENDING)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  // Índices otimizados para performance
  @@unique([workId, sourceId, source], name: "workId_sourceId_source")
  @@index([workId, isActive])
  @@index([workId, type, groupIndex])
  @@index([source, processingStatus])
  @@index([isActive])
  @@index([lastAccessed, isActive])
  @@index([imslpTotalCounts])
  @@index([uploadedBy])
  @@index([dataQuality])
  @@index([verificationStatus])
  @@index([qualityScore])
  @@map("work_scores")
}

model UserToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?   @db.ObjectId // OPCIONAL para tokens anônimos
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  metadata  Json? // Dados extras se necessário
  ipAddress String? // IP que solicitou
  userAgent String? // User agent que solicitou

  // NOVOS CAMPOS para identificação anônima
  anonymousEmail String? // Email do usuário anônimo (para newsletter)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELAÇÃO OPCIONAL
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices
  @@index([type, expiresAt])
  @@index([userId, type])
  @@index([anonymousEmail])
  @@map("user_tokens")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Composer {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  fullName String

  // Nomes alternativos da página IMSLP
  alternativeNames String? // Nomes alternativos/Transliterações

  // Datas melhoradas - podem conter dia/mês/ano
  birthDate String? // Ex: "31 de janeiro de 1797", "1797", "January 31, 1797"
  deathDate String? // Ex: "28 de novembro de 1828", "1828", "November 28, 1828"

  portraitUrl String?
  epochId     String  @db.ObjectId
  epochName   String?
  bio         String?
  videoUrl    String?
  // Dados IMSLP
  permLinkImslp String?
  imslpId       String?
  wikipediaLink String?

  // Dados estatísticos e geográficos
  nationality String? // País/nacionalidade (ex: "German", "Austrian", "Brazilian")
  instruments String? // Instrumentos associados (ex: "Piano, Violin, Orchestra")

  // Categorias e classificações IMSLP
  imslpCategories String? // Categorias do IMSLP (ex: "Romantic composers, German composers, Pianists")

  // Metadados da página IMSLP
  pageQuality String? // Qualidade da página: "high", "medium", "low"

  // Dados de cache e verificação
  lastVerified     DateTime @default(now())
  dataCompleteness Float? // Porcentagem de completude dos dados (0-100)
  hasValidImage    Boolean  @default(false) // Se tem imagem válida (não placeholder)

  createdBy String? @db.ObjectId
  isCustom  Boolean @default(false)

  // Campos de qualidade e verificação
  dataQuality        String? // "high", "medium", "low"
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?
  dataSource         String?   @default("none") // 'none', 'imslp', 'wikipedia'
  isVerified         Boolean   @default(false) // Status de verificação
  verificationNotes  String? // Notas da verificação

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json? // Histórico de edições

  // Campos existentes
  primaryRoleId String @db.ObjectId
  primaryRole   Role   @relation("PrimaryRole", fields: [primaryRoleId], references: [id])
  createdByUser User?  @relation("UserCreatedComposers", fields: [createdBy], references: [id], onDelete: Cascade)

  roles     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔄 RELAÇÕES EXISTENTES - ATUALIZADAS
  epoch           Epoch              @relation(fields: [epochId], references: [id])
  works           Work[] // 🔄 CASCADE - deletar obras quando deletar compositor
  favoritedBy     FavoriteComposer[] // 🔄 CASCADE será configurado no FavoriteComposer
  favoriteByUsers User[]             @relation("FavoriteComposer")

  verifier User? @relation("VerifiedComposers", fields: [verifiedBy], references: [id], onDelete: SetNull)

  // Índices otimizados
  @@index([name])
  @@index([epochId])
  @@index([fullName])
  @@index([verifiedBy])
  @@index([isVerified])
  @@index([alternativeNames])
  @@index([imslpCategories])
  @@index([primaryRoleId])
  @@index([imslpId])
  @@index([nationality])
  @@index([birthDate])
  @@index([deathDate])
  @@index([hasValidImage])
  @@index([name, epochId])
  @@index([epochId, primaryRoleId])
  @@index([name, fullName])
  @@index([nationality, epochId])
  @@index([createdBy])
  @@index([isCustom])
  @@index([verificationStatus])
  @@index([dataQuality])
}

model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers       Composer[]
  works           Work[]
  favoriteByUsers User[]     @relation("FavoriteEpoch")

  @@index([name])
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  primaryComposers Composer[] @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String           @unique
  category   String?
  difficulty String?
  createdAt  DateTime         @default(now())
  users      UserInstrument[]
  works      Work[]

  advertisements Advertisement[]

  @@index([category])
}

model WorkGenre {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  composerId       String   @db.ObjectId
  instrumentId     String   @db.ObjectId
  epochId          String   @db.ObjectId
  videoUrl         String?
  imslpPermlink    String
  imslpId          String
  opOrCatalog      String?
  compositionYear  String?
  firstPublishDate String?
  tone             String?
  mediaDuration    String?
  workStyle        String?
  moviment         String?
  categoryNames    String[] @default([])
  workGenresArr    String[] @default([])

  dedicateTo      String?
  instrumentation String?
  workType        WorkType @default(INDIVIDUAL)

  movementNumber Int?
  parentWorkId    String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtitle  String?
  imslpTags String[] @default([])

  // MÍDIA SIMPLIFICADA E MELHORADA
  spotifyTrackId      String? // ID da track
  spotifyTrackUrl     String? // URL da track
  spotifyDisplayTitle String? // "Frédéric Chopin - Yuja Wang"
  spotifyDuration     Int? // Duração em ms
  spotifyArtists      Json? // String? → Json?
  spotifyThumbnail    String? // URL da capa do álbum

  // YouTube (essencial)
  youtubeVideoId  String? // ID do vídeo
  youtubeVideoUrl String? // URL do vídeo
  youtubeTitle    String? // Título do vídeo

  // Áudio customizado
  customAudioUrl      String? // URL de áudio customizado (upload OU fonte alternativa)
  customAudioFile     String? // Arquivo de áudio local
  customAudioSource   String? // "upload", "internet_archive", "wikimedia", etc.
  customAudioMetadata Json? // Metadados da fonte alternativa

  // Metadados de busca (simplificado)
  mediaSource      String?   @default("none") // "auto", "manual", "none"
  lastMediaSearch  DateTime?
  mediaSearchError String?

  // VIDEO AULA EXPANDIDA
  videoAulaUrl     String? // URL externa
  videoAulaFile    String? // Arquivo local
