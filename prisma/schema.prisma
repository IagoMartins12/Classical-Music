// schema.prisma - Schema atualizado com sistema incremental de cache

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums existentes
enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PracticeFocus {
  TECHNICAL
  EXPRESSIVITY
  PRECISION
  SIGHT_READING
  MEMORIZATION
  PERFORMANCE
  REVIEW
}

enum WorkType {
  INDIVIDUAL
  COMPLETE_WORK
  ARRANGEMENT
  COLLECTION
  COLLABORATION
  COMPOSITION
  COLLECTED_WORKS
  COLLECTIONS_WITH
}

enum UserType {
  MUSIC_STUDENT
  CASUAL_USER
  PROFESSIONAL
  TEACHER
}

enum AnnotationType {
  TEXT_NOTE
  HIGHLIGHT
  DRAWING
  BOOKMARK
  FINGERING
  BOWINGS
  DYNAMICS
  TEMPO_MARK
}

enum IMSLPScoreType {
  SCORES
  PARTS
  ARRANGEMENTS
  LIBRETTOS
  OTHERS
  SOURCES
}

// Enums para sistema de cache
enum ScoreSource {
  IMSLP // Do IMSLP
  CUSTOM // Adicionado manualmente
  UPLOAD // Upload do usuário
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Enums para anotações musicais
enum AnnotationCategory {
  TECHNIQUE // Técnica (dedilhado, articulação, etc.)
  INTERPRETATION // Interpretação (dinâmica, fraseado, etc.)
  THEORY // Teoria (harmonia, forma, análise)
  PRACTICE_TIP // Dicas de estudo
  PERFORMANCE // Performance e palco
  HISTORICAL // Contexto histórico
  GENERAL // Anotação geral
}

enum AnnotationDifficulty {
  BEGINNER // Para iniciantes
  INTERMEDIATE // Para nível intermediário  
  ADVANCED // Para avançados
  ALL_LEVELS // Para todos os níveis
}

enum AnnotationScope {
  SPECIFIC_MEASURE // Compasso específico
  SECTION // Seção da obra
  MOVEMENT // Movimento inteiro
  ENTIRE_WORK // Obra inteira
}


enum AdType {
  BANNER
  VIDEO
  CARD
  SIDEBAR
  NATIVE
  POPUP
}

enum AdPlacement {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
  CONTENT_TOP
  CONTENT_BOTTOM
  BETWEEN_CONTENT
  FOOTER
  MODAL
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  SCHEDULED
  EXPIRED
}

enum AdTargetType {
  GENERAL // Publicidade geral
  INSTRUMENT // Por instrumento específico
  USER_LEVEL // Por nível do usuário (geral, professor, estudante)
}

enum AdUserLevel {
  ALL // Todos os usuários
  STUDENT // Apenas estudantes (role 0)
  TEACHER // Apenas professores (role 1)
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// Enums para o sistema de newsletter
enum SubscriptionStatus {
  PENDING     // Aguardando confirmação (double opt-in)
  ACTIVE      // Inscrito ativo
  UNSUBSCRIBED // Cancelou inscrição
  BOUNCED     // Email com bounce
  BLOCKED     // Bloqueado por spam/abuse
}

enum EmailTemplateType {
  WELCOME           // Email de boas-vindas
  WEEKLY_DIGEST     // Resumo semanal
  NEW_COMPOSER      // Novo compositor adicionado
  NEW_WORK          // Nova obra adicionada
  STUDY_REMINDER    // Lembrete de estudo
  CUSTOM_CAMPAIGN   // Campanha personalizada
  UNSUBSCRIBE       // Confirmação de cancelamento
  PASSWORD_RESET
  ACCOUNT_CONFIRMATION
}

enum CampaignStatus {
  DRAFT       // Rascunho
  SCHEDULED   // Agendada
  SENDING     // Enviando
  SENT        // Enviada
  PAUSED      // Pausada
  CANCELLED   // Cancelada
  FAILED      // Falhou
}

enum EmailEventType {
  SENT        // Email enviado
  DELIVERED   // Entregue
  OPENED      // Aberto
  CLICKED     // Clicou em link
  BOUNCED     // Retornou (bounce)
  COMPLAINED  // Marcado como spam
  UNSUBSCRIBED // Cancelou inscrição
}

enum TokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
  NEWSLETTER_CONFIRMATION
}
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String?
  lastName       String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  bio            String?
  gender         String?
  birthday       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role Int @default(0) //0 = usuario comum 2, 1 = admin 2 = super admin

  userType            UserType?
  onboardingCompleted Boolean   @default(false)

  city    String?
  state   String?
  country String?

  favoriteComposerId String? @db.ObjectId
  favoriteEpochId    String? @db.ObjectId

  experienceLevel     DifficultyLevel @default(BEGINNER)
  practiceTimePerWeek Int?

  profilePublic Boolean @default(true)
  showLocation  Boolean @default(false)

  practiceReminders Boolean @default(true)
  progressTracking  Boolean @default(true)
  publicProgress    Boolean @default(false)

  totalStudyTime Int @default(0)
  currentStreak  Int @default(0)
  longestStreak  Int @default(0)

  studyModeSettings Json?


  // Configurações de publicidade
  showAds       Boolean @default(true) // Usuário quer ver ads?

  // Anotações relacionadas
  workAnnotations   WorkAnnotation[]
  annotationVotes   AnnotationHelpfulVote[]
  verifiedComposers Composer[]              @relation("VerifiedComposers")


  // Estatísticas de contribuição
  helpfulAnnotationsCount Int      @default(0) // Cache de anotações úteis
  totalAnnotationsCount   Int      @default(0) // Cache total de anotações
  expertInstruments       String[] @default([]) // Instrumentos que o usuário é expert

  // Relações de moderação
  reportedUploads  UploadModeration[] @relation("ReportedUploads")
  moderatedUploads UploadModeration[] @relation("ModeratedUploads")
  uploadHistory    UploadHistory[]
  generatedReports GeneratedReport[]  @relation("GeneratedReports")

  // Estatísticas de upload
  totalUploads    Int @default(0)
  approvedUploads Int @default(0)
  uploadScore     Int @default(0) // Score baseado na qualidade dos uploads

  // Permissões de upload


  // Limites de upload
  uploadLimitDaily      Int      @default(50)
  uploadLimitMonthly    Int      @default(1000)
  currentDailyUploads   Int      @default(0)
  currentMonthlyUploads Int      @default(0)
  lastUploadReset       DateTime @default(now())

  // Relations
  accounts       Account[]
  sessions       Session[]
  selectedScores UserSelectedScore[]

  tokens        UserToken[]
  testEmailLists TestEmailList[] @relation("TestEmailListCreator")

  createdWorks     Work[]      @relation("UserCreatedWorks")
  createdComposers Composer[]  @relation("UserCreatedComposers")
  createdScores    WorkScore[] @relation("UserCreatedScores")

  favoriteComposer Composer? @relation("FavoriteComposer", fields: [favoriteComposerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favoriteEpoch    Epoch?    @relation("FavoriteEpoch", fields: [favoriteEpochId], references: [id])

  createdAds Advertisement[] @relation("AdCreator")
  editedAds  Advertisement[] @relation("AdEditor")
  adStats    AdStats[]       @relation("AdStatsUser")

  // Relações de newsletter (ADICIONAR)
  newsletterSubscription    NewsletterSubscriber?         @relation("NewsletterSubscriber")
  createdNewsletterTemplates NewsletterTemplate[]         @relation("NewsletterTemplateCreator")
  editedNewsletterTemplates  NewsletterTemplate[]         @relation("NewsletterTemplateEditor")
  createdNewsletterCampaigns NewsletterCampaign[]         @relation("NewsletterCampaignCreator")
  editedNewsletterCampaigns  NewsletterCampaign[]         @relation("NewsletterCampaignEditor")
  editedNewsletterSettings   NewsletterSettings[]         @relation("NewsletterSettingsEditor")
  
  approvedNewsletterTemplates NewsletterTemplate[]        @relation("NewsletterTemplateApprover")
  templateUsageLogs          TemplateUsageLog[]
  createdTemplateFragments   TemplateFragment[]
  favoriteScores FavoriteScore[]

  instruments       UserInstrument[]
  annotations       Annotation[]
  favoriteWorks     FavoriteWork[]
  favoriteComposers FavoriteComposer[]
  wantToLearn       WantToLearn[]
  learned           Learned[]
  studySessions     StudySession[]
  learningGoals     LearningGoal[]

  pdfAnnotations PdfAnnotation[]
  scoreBookmarks ScoreBookmark[]

  @@index([userType])
  @@index([onboardingCompleted])
  @@index([uploadScore])
}

// 🆕 Model para cache de partituras com sistema incremental
model WorkScore {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  workId   String      @db.ObjectId
  sourceId String // ID da partitura na fonte (IMSLP ID, custom ID, etc.)
  source   ScoreSource @default(IMSLP)

  // Dados básicos da partitura
  title       String
  downloadUrl String?
  fileSize    String?
  pageCount   String?
  fileFormat  String  @default("PDF")

  // Metadados IMSLP
  editor       String?
  publisher    String?
  copyright    String?
  thumbnailUrl String?
  uploadDate   String?
  uploader     String?
  notes        String?

  // Classificação e organização
  type       IMSLPScoreType @default(SCORES)
  groupIndex Int?           @default(0)
  groupTitle String?

  // Métricas do IMSLP
  rating        Float?
  ratingsCount  Int?
  downloadCount Int?

  // Relação com usuário criador
  createdByUser User? @relation("UserCreatedScores", fields: [uploadedBy], references: [id])

  // Campos de qualidade e verificação
  dataQuality        String? // "high", "medium", "low"
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json? // Histórico de edições

  // Campos técnicos melhorados
  fileMD5         String? // Hash MD5 do arquivo
  compressionType String? // Tipo de compressão
  qualityScore    Int? // Score de qualidade (1-100)

  // Dados customizados (para partituras não-IMSLP)
  isCustom   Boolean @default(false)
  uploadedBy String? // ID do usuário que fez upload
  customData Json? // Dados extras específicos

  // Metadados de processamento
  ocrProcessed Boolean @default(false)
  ocrText      String? // Texto extraído por OCR
  ocrAccuracy  Float? // Precisão do OCR (0-1)

  // Tags e categorização
  qualityTags String[] @default([]) // Tags de qualidade
  sourceTags  String[] @default([]) // Tags de fonte

  // Cache e controle
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastVerified DateTime  @default(now())
  lastAccessed DateTime  @default(now())
  accessCount  Int       @default(0)
  priority     Int       @default(0) // Para ordenação
  expiresAt    DateTime? // TTL do cache
  cacheVersion String    @default("1.0")

  // 🆕 Campos para sistema incremental
  imslpTotalCounts String? // JSON com totais reais do IMSLP por tipo
  lastIMSLPSync    DateTime? // Última sincronização completa com IMSLP

  // Status de processamento
  processingStatus ProcessingStatus @default(PENDING)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  // Índices otimizados para performance
  @@unique([workId, sourceId, source], name: "workId_sourceId_source")
  @@index([workId, isActive, priority])
  @@index([workId, type, groupIndex])
  @@index([source, processingStatus])
  @@index([isActive, expiresAt])
  @@index([lastAccessed, isActive])
  @@index([priority, createdAt])
  @@index([lastIMSLPSync]) // 🆕 Índice para sincronização
  @@index([imslpTotalCounts]) // 🆕 Índice para metadados
  @@index([uploadedBy])
  @@index([dataQuality])
  @@index([verificationStatus])
  @@index([qualityScore])
  @@index([ocrProcessed])
  @@index([qualityTags])
  @@map("work_scores")
}

model UserToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?   @db.ObjectId // 🆕 TORNAR OPCIONAL para tokens anônimos
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  metadata  Json?     // Dados extras se necessário
  ipAddress String?   // IP que solicitou
  userAgent String?   // User agent que solicitou
  
  // 🆕 NOVOS CAMPOS para identificação anônima
  anonymousEmail String? // Email do usuário anônimo (para newsletter)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // 🆕 RELAÇÃO OPCIONAL
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Índices
  @@index([type, expiresAt])
  @@index([userId, type])
  @@index([anonymousEmail]) // 🆕 Índice para email anônimo
  @@map("user_tokens")
}


// Models existentes (mantendo todos)

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Composer {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  fullName  String
  otherName String? // Nome alternativo (contentSub)

  // Nomes alternativos da página IMSLP
  alternativeNames  String? // Nomes alternativos/Transliterações
  namesInOtherLangs String? // Nome em outras línguas  
  pseudonyms        String? // Pseudônimos

  // Datas melhoradas - podem conter dia/mês/ano
  birthDate String? // Ex: "31 de janeiro de 1797", "1797", "January 31, 1797"
  deathDate String? // Ex: "28 de novembro de 1828", "1828", "November 28, 1828"

  portraitUrl String?
  epochId     String  @db.ObjectId
  epochName   String?
  bio         String?

  // Informações detalhadas da página IMSLP
  diverseInfo   String? // Informação diversa (biografia detalhada)
  externalLinks String? // Links externos úteis

  // Dados IMSLP
  permLinkImslp String?
  imslpId       String?
  wikipediaLink String?

  // Dados estatísticos e geográficos
  nationality String? // País/nacionalidade (ex: "German", "Austrian", "Brazilian")
  instruments String? // Instrumentos associados (ex: "Piano, Violin, Orchestra")

  // Categorias e classificações IMSLP
  imslpCategories String? // Categorias do IMSLP (ex: "Romantic composers, German composers, Pianists")

  // Metadados da página IMSLP
  lastModifiedImslp String? // Data da última modificação no IMSLP
  pageStatus        String? // Status da página: "complete", "stub", "needs_work"
  pageQuality       String? // Qualidade da página: "high", "medium", "low"

  // Dados de cache e verificação
  lastVerified     DateTime @default(now())
  dataCompleteness Float? // Porcentagem de completude dos dados (0-100)
  hasValidImage    Boolean  @default(false) // Se tem imagem válida (não placeholder)

  // Campos para rastreamento de uploads
  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("UserCreatedComposers", fields: [createdBy], references: [id])
  isCustom      Boolean @default(false)

  // Campos de qualidade e verificação
  dataQuality        String? // "high", "medium", "low"
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?
  dataSource         String?   @default("none") // 'none', 'imslp', 'wikipedia'
  isVerified         Boolean   @default(false) // Status de verificação
  verificationNotes  String? // Notas da verificação

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json? // Histórico de edições

  // Campos específicos do IMSLP melhorados
  imslpScore      Int? // Score/ranking no IMSLP
  imslpWorkCount  Int? // Número de obras no IMSLP
  imslpPopularity Int? // Popularidade no IMSLP

  // Campos existentes
  primaryRoleId String   @db.ObjectId
  primaryRole   Role     @relation("PrimaryRole", fields: [primaryRoleId], references: [id])
  roles         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações existentes
  epoch           Epoch              @relation(fields: [epochId], references: [id])
  works           Work[]
  favoritedBy     FavoriteComposer[]
  favoriteByUsers User[]             @relation("FavoriteComposer")

  verifier User? @relation("VerifiedComposers", fields: [verifiedBy], references: [id])


  // Índices otimizados
  @@index([name])
  @@index([epochId])
  @@index([fullName])
  @@index([otherName])
  @@index([verifiedBy]) // Novo índice para verificador
  @@index([isVerified]) // Novo índice para verificação
  @@index([alternativeNames])
  @@index([imslpCategories])
  @@index([primaryRoleId])
  @@index([imslpId])
  @@index([nationality])
  @@index([birthDate])
  @@index([deathDate])
  @@index([hasValidImage])
  @@index([name, epochId])
  @@index([epochId, primaryRoleId])
  @@index([name, fullName])
  @@index([nationality, epochId])
  @@index([createdBy])
  @@index([isCustom])
  @@index([verificationStatus])
  @@index([dataQuality])
}
model Epoch {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  composers       Composer[]
  works           Work[]
  favoriteByUsers User[]     @relation("FavoriteEpoch")


  @@index([name])
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  primaryComposers Composer[] @relation("PrimaryRole")

  @@index([name])
}

model Instrument {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String           @unique
  category   String?
  difficulty String?
  createdAt  DateTime         @default(now())
  users      UserInstrument[]
  works      Work[]

  advertisements Advertisement[]


  @@index([category])
}

model WorkGenre {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  composerId   String @db.ObjectId
  instrumentId String @db.ObjectId
  epochId      String @db.ObjectId

  videoUrl         String?
  imslpPermlink    String
  imslpId          String
  opOrCatalog      String?
  compositionYear  String?
  firstPublishDate String?
  tone             String?
  mediaDuration    String?
  workStyle        String?
  moviment         String?
  categoryNames    String[] @default([])
  workGenresArr    String[] @default([])

  dedicateTo             String?
  dedicationComposerLink String?
  instrumentation        String?
  workType               WorkType @default(INDIVIDUAL)

  isPartOfCollection Boolean @default(false)
  parentWorkId       String? @db.ObjectId
  movementNumber     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtitle          String?
  timeSignature     String?
  tempoMarking      String?
  movementsDetailed Json?
  imslpTags         String[]         @default([])
  difficultyLevel   DifficultyLevel?

  // 🆕 CAMPOS DE MÍDIA AUTOMÁTICA
  spotifyTrackId    String?   // ID da track no Spotify
  spotifyTrackUrl   String?   // URL da track no Spotify  
  spotifyPreviewUrl String?   // URL do preview (30s) do Spotify
  spotifyAlbumArt   String?   // URL da capa do álbum
  spotifyArtists    String[]  @default([]) // Lista de artistas encontrados
  spotifyAlbumName  String?   // Nome do álbum
  spotifyDuration   Int?      // Duração em ms
  spotifyPopularity Int?      // Popularidade (0-100)

  youtubeVideoId    String?   // ID do vídeo no YouTube
  youtubeVideoUrl   String?   // URL completa do vídeo
  youtubeThumbnail  String?   // URL da thumbnail
  youtubeTitle      String?   // Título do vídeo encontrado
  youtubeChannel    String?   // Canal do YouTube
  youtubeDuration   String?   // Duração formatada (ex: "PT4M33S")
  youtubeViewCount  String?   // Número de visualizações
  youtubePublishedAt DateTime? // Data de publicação

  // Metadados de busca
  mediaSearchStatus String?   @default("pending") // "pending", "searching", "found", "not_found", "error"
  mediaSearchAttempts Int     @default(0)
  lastMediaSearch   DateTime?
  mediaSearchError  String?   // Último erro de busca
  mediaSearchStrategy String? // Estratégia usada na busca bem-sucedida

  // Configurações de qualidade
  mediaQualityScore  Int?     // Score de qualidade (0-100) baseado em match de título/artista
  manuallyVerified   Boolean  @default(false) // Se foi verificado manualmente
  mediaPreferences   Json?    // Preferências de mídia específicas da obra

  // Cache de busca para evitar re-buscas desnecessárias
  searchCacheData   Json?     // Cache dos dados de busca
  searchCacheExpiry DateTime? // Expiração do cache

  //Verificação
  verificationStatus String? // "verified", "pending", "disputed"
  verifiedBy         String?   @db.ObjectId
  verifiedAt         DateTime?
  isVerified         Boolean   @default(false) // Status de verificação

  // Campos para rastreamento de uploads
  createdBy     String? @db.ObjectId
  createdByUser User?   @relation("UserCreatedWorks", fields: [createdBy], references: [id])
  isCustom      Boolean @default(false)

  // Metadados de edição
  lastEditedBy String?   @db.ObjectId
  lastEditedAt DateTime?
  editHistory  Json? // Histórico de edições

  // Campos específicos do IMSLP melhorados
  imslpScore     Int? // Score/ranking no IMSLP
  imslpDownloads Int? // Downloads no IMSLP
  imslpRating    Float? // Rating no IMSLP

  // Campos técnicos melhorados
  keySignature    String? // Armadura de clave
  moodTags        String[] @default([]) // Tags de humor/atmosfera

  composer   Composer   @relation(fields: [composerId], references: [id])
  epoch      Epoch      @relation(fields: [epochId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  parentWork Work?  @relation("WorkHierarchy", fields: [parentWorkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childWorks Work[] @relation("WorkHierarchy")

  favoriteScores     FavoriteScore[]
  scoreFavoriteStats ScoreFavoriteStats[]

  annotations    Annotation[]
  favoriteBy     FavoriteWork[]
  wantToLearners WantToLearn[]
  learners       Learned[]
  studySessions  StudySession[]
  selectedScores UserSelectedScore[]

  pdfAnnotations PdfAnnotation[]
  scoreBookmarks ScoreBookmark[]

  // Anotações relacionadas
  workAnnotations WorkAnnotation[]

  // Estatísticas de anotações (cache para performance)
  annotationsCount        Int       @default(0)
  helpfulAnnotationsCount Int       @default(0)
  lastAnnotationAt        DateTime?

  // Relações com sistema de cache incremental
  cachedScores   WorkScore[]

  mediaSearchLogs MediaSearchLog[]
  
  // 🆕 ÍNDICES OTIMIZADOS PARA BUSCA DE OBRAS - SUBSTITUA OS ÍNDICES EXISTENTES
  @@index([title]) // Busca simples por título
  @@index([opOrCatalog]) // Busca por catálogo/opus
  @@index([composerId]) // Join com compositor
  @@index([imslpId])
  // 🆕 ÍNDICES COMPOSTOS PARA BUSCA OTIMIZADA
  @@index([title, composerId]) // Busca por título + compositor
  @@index([composerId, title]) // Ordem reversa para diferentes queries
  @@index([opOrCatalog, composerId]) // Busca por opus + compositor
  // 🆕 ÍNDICES PARA ORDENAÇÃO E FILTROS
  @@index([title, createdAt]) // Ordenação por título e data
  @@index([composerId, createdAt]) // Obras recentes de um compositor
  @@index([workType])
  @@index([parentWorkId])
  @@index([isPartOfCollection])
  // Índices existentes mantidos (não remover)
  @@index([composerId, instrumentId])
  @@index([composerId, epochId])
