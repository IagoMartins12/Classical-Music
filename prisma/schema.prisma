  userLevel       DifficultyLevel?
  userInstruments String[]         @default([]) // IDs dos instrumentos do usuário

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  user          User?         @relation("AdStatsUser", fields: [userId], references: [id])

  @@index([advertisementId, date])
  @@index([date])
  @@index([userId])
  @@index([country])
  @@index([device])
  @@map("ad_stats")
}

// Cache de estatísticas agregadas
model AdStatsAggregate {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  advertisementId String @db.ObjectId

  // Período
  period    String // 'daily', 'weekly', 'monthly'
  startDate DateTime
  endDate   DateTime

  // Métricas agregadas
  totalImpressions Int   @default(0)
  totalClicks      Int   @default(0)
  totalConversions Int   @default(0)
  avgCTR           Float @default(0) // Click-through rate
  avgCPC           Float @default(0) // Cost per click

  // Breakdown por dispositivo
  mobileImpressions  Int @default(0)
  tabletImpressions  Int @default(0)
  desktopImpressions Int @default(0)

  mobileClicks  Int @default(0)
  tabletClicks  Int @default(0)
  desktopClicks Int @default(0)

  // Top países
  topCountries Json? // {country: count}
  topPages     Json? // {page: impressions}

  // Performance por horário
  hourlyStats Json? // {hour: {impressions, clicks}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // advertisement  Advertisement @relation("AdAggregateStats", fields: [advertisementId], references: [id], onDelete: Cascade)

  @@unique([advertisementId, period, startDate])
  @@index([period, startDate])
  @@map("ad_stats_aggregate")
}

// Templates de publicidade
model AdTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  description String?
  category    String // 'music-school', 'teacher', 'instrument-shop', etc.

  // Template structure
  type         AdType
  placement    AdPlacement
  htmlTemplate String // Template HTML
  cssTemplate  String? // Template CSS
  jsTemplate   String? // Template JavaScript

  // Template variables
  variables Json // Schema das variáveis: {name, type, required, default}

  // Preview
  previewImage String?

  // Usage
  isPublic   Boolean @default(true)
  usageCount Int     @default(0)

  // Creator
  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("AdTemplateCreator", fields: [createdBy], references: [id])

  @@index([category, isPublic])
  @@index([type, placement])
  @@map("ad_templates")
}
