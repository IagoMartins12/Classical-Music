    "@tiptap/react": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.7.0",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongodb": "^6.17.0",
    "multer": "^2.0.2",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.4",
    "node-cron": "^3.0.3",
    "node-os-utils": "^1.3.7",
    "nodemailer": "^7.0.7",
    "prisma": "^6.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "sharp": "^0.34.2",
    "stripe": "^19.2.0",
    "systeminformation": "^5.27.7",
    "tailwindcss": "^4",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.64",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.3",
