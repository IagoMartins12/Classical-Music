{
  "name": "classical-music",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint-staged": "lint-staged",
    "start": "next start",
    "lint": "next lint",
    "scraper:view:osesp": "tsx scripts/view-osesp-events.ts",
    "scraper:import:osesp": "tsx scripts/import-osesp-events.ts",
    "// === SCRIPTS DE LIMPEZA DE ARQUIVOS ===": "",
    "orphan-files:scan": "npx tsx scripts/orphan-files/orphan-cleanup.ts scan",
    "orphan-files:scan-scores": "npx tsx scripts/orphan-files/orphan-cleanup.ts scan-category scores",
    "orphan-files:scan-ads": "npx tsx scripts/orphan-files/orphan-cleanup.ts scan-category advertisements",
    "scraper": "tsx scripts/imslp-scraper.ts",
    "scraper:start": "tsx scripts/imslp-scraper.ts start",
    "scraper:stop": "tsx scripts/imslp-scraper.ts stop",
    "scraper:reset": "tsx scripts/imslp-scraper.ts reset",
    "scraper:status": "tsx scripts/imslp-scraper.ts status",
    "work-scraper": "tsx scripts/imslp-works-scraper.ts",
    "work-scraper:start": "tsx scripts/imslp-works-scraper.ts start",
    "work-scraper:stop": "tsx scripts/imslp-works-scraper.ts stop",
    "work-scraper:reset": "tsx scripts/imslp-works-scraper.ts reset",
    "work-scraper:status": "tsx scripts/imslp-works-scraper.ts status",
    "// === BACKUP CORE SCRIPTS ===": "",
    "backup": "node --max-old-space-size=4096 -r tsx/cjs scripts/backup/backup.ts backup",
    "backup:restore": "node --max-old-space-size=4096 -r tsx/cjs scripts/backup/backup.ts restore",
    "backup:list": "tsx scripts/backup/backup.ts list",
    "backup:verify": "tsx scripts/backup/backup.ts verify",
    "// === BACKUP SELETIVO SCRIPTS ===": "",
    "backup:selective": "tsx scripts/backup/selective-backup.ts backup",
    "backup:selective:restore": "tsx scripts/backup/selective-backup.ts restore",
    "backup:selective:list": "tsx scripts/backup/selective-backup.ts list",
    "backup:selective:users": "tsx scripts/backup/selective-backup.ts backup user userInstrument --with-dependencies --name=\"Backup Usuarios\"",
    "backup:selective:content": "tsx scripts/backup/selective-backup.ts backup composer work workScore --with-dependencies --name=\"Backup Conteudo Musical\"",
    "backup:selective:interactions": "tsx scripts/backup/selective-backup.ts backup annotation workAnnotation favoriteWork favoriteComposer --with-dependencies --name=\"Backup Interacoes\"",
    "backup:selective:system": "tsx scripts/backup/selective-backup.ts backup user epoch role instrument --name=\"Backup Sistema Base\"",
    "// === MAINTENANCE SCRIPTS ===": "",
    "maintenance:cleanup": "tsx scripts/backup/backup-utils.ts cleanup",
    "maintenance:optimize": "tsx scripts/backup/backup-utils.ts optimize",
    "maintenance:cache": "tsx scripts/backup/backup-utils.ts clean-cache",
    "maintenance:logs": "tsx scripts/backup/backup-utils.ts rotate-logs",
    "maintenance:health": "tsx scripts/backup/backup-utils.ts health",
    "maintenance:suite": "tsx scripts/backup/backup-utils.ts maintenance-suite",
    "// === SCHEDULED BACKUP SCRIPTS ===": "",
    "backup:scheduler": "tsx scripts/backup/scheduled-backup.ts",
    "backup:scheduler:start": "tsx scripts/backup/scheduled-backup.ts start",
    "backup:scheduler:stop": "tsx scripts/backup/scheduled-backup.ts stop",
    "backup:scheduler:status": "tsx scripts/backup/scheduled-backup.ts status",
    "backup:now": "tsx scripts/backup/scheduled-backup.ts backup-now",
    "// === DIAGNOSTIC SCRIPTS ===": "",
    "backup:diagnose": "tsx scripts/backup/diagnose-backup.ts",
    "backup:monitor": "tsx scripts/backup/backup-monitor.ts",
    "teste2": "tsx scripts/workstyle-epoch-fixer.ts",
    "teste": "tsx scripts/backup/backup-utils.ts",
    "backup:custom": "tsx scripts/backup/backup-utils.ts custom-backup",
    "vercel-build": "prisma generate && next build",
    "difficulty-scraper": "tsx scripts/difficulty-scraper.ts",
    "difficulty:analyze": "npm run difficulty-scraper start",
    "difficulty:apply": "npm run difficulty-scraper apply",
    "difficulty:status": "npm run difficulty-scraper status",
    "difficulty:reset": "npm run difficulty-scraper reset",
    "difficulty:stop": "npm run difficulty-scraper stop",
    "db:migrate:difficulty": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
