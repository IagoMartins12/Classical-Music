# =============================================================================
# FRONT — PRODUÇÃO (VPS, branch main)
# =============================================================================
# NEXT_PUBLIC_* e NEST_API_URL entram no BUILD da imagem: no docker-compose do
# VPS eles vão em `build.args` do serviço do front (o Dockerfile os recebe como
# ARG). Os demais vão em `environment`/`env_file`, em tempo de execução.
# =============================================================================

# --- build.args ---
NEXT_PUBLIC_API_URL=https://api.opusatlas.com.br/api
# No BUILD tem de ser o endereço público: o `docker build` não enxerga a rede
# do compose, e o build pré-renderiza páginas chamando a API.
NEST_API_URL=https://api.opusatlas.com.br/api

# --- environment / env_file ---
# Opcional: em execução, o servidor do Next pode falar com a API pela rede
# interna do compose (sem sair para a internet). Sobrescreve o valor do build.
# Use o nome do serviço da API no seu docker-compose.
# NEST_API_URL=http://<servico-da-api>:4000/api
# O MESMO valor do FRONT_REVALIDATE_SECRET da API de produção.
FRONT_REVALIDATE_SECRET=<mesmo da API prd>
# Cache de ISR compartilhado entre as réplicas do front (serviço redis do compose).
REDIS_URL=redis://redis:6379

# NÃO defina em produção:
#   NEXT_PUBLIC_AUTH_COOKIE_PREFIX  — produção usa o padrão (opus)
#   SITE_NOINDEX                    — produção tem de ser indexada
#   ALLOW_BUILD_WITHOUT_API         — só existe no CI
#   NEXT_PUBLIC_SCRAPER_API_KEY     — NEXT_PUBLIC_ vai para o navegador
