# =============================================================================
# FRONT — HOMOLOGAÇÃO (Vercel, Production Branch = develop)
# =============================================================================
# Estas vão no painel da Vercel (Settings → Environment Variables → Production).
# NEXT_PUBLIC_* entram no BUILD: mudou, tem de fazer redeploy.
# =============================================================================

NEXT_PUBLIC_API_URL=https://api.hml.opusatlas.com.br/api
NEST_API_URL=https://api.hml.opusatlas.com.br/api
# O MESMO valor do FRONT_REVALIDATE_SECRET da API de homologação.
FRONT_REVALIDATE_SECRET=<mesmo da API hml>
# Igual ao AUTH_COOKIE_PREFIX da API de homologação.
NEXT_PUBLIC_AUTH_COOKIE_PREFIX=opus_hml
# robots bloqueando tudo + X-Robots-Tag: noindex. Sem isso o Google indexa a
# homologação como cópia do site.
SITE_NOINDEX=true

# NÃO defina na Vercel:
#   REDIS_URL                    — lá o cache de ISR é da plataforma
#   ALLOW_BUILD_WITHOUT_API      — só existe no CI
#   NEXT_PUBLIC_SCRAPER_API_KEY  — NEXT_PUBLIC_ vai para o navegador
