{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * 0",
      "description": "Limpeza profunda semanal - domingos às 2h UTC",
      "method": "POST",
      "headers": {
        "content-type": "application/json",
        "x-cron-key": "${CRON_SECRET_KEY}"
      },
      "body": {
        "action": "weekly-deep-clean"
      }
    }
  ],
  "functions": {
    "app/api/imslp-scores/route.ts": {
      "maxDuration": 120
    }
  },
  "env": {
    "CRON_SECRET_KEY": "@cron-secret-key"
  }
}
