# =============================================================================
# FRONT — desenvolvimento local (copie para .env.local)
# =============================================================================
# O front não guarda segredo de servidor: banco, SMTP, Stripe, Cloudinary e
# chaves de IA vivem na API. Se o seu .env antigo ainda tem DATABASE_URL,
# NEXTAUTH_SECRET ou chaves do Stripe, pode apagá-los — nada aqui os lê.
# Homologação: .env.hml.example · Produção: .env.prd.example
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEST_API_URL=http://localhost:4000/api
# Igual ao FRONT_REVALIDATE_SECRET do .env.local da API.
FRONT_REVALIDATE_SECRET=
# Opcional: cache de ISR no Redis (sem ele, fica em memória).
# REDIS_URL=redis://localhost:6379
